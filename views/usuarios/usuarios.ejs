<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>ACCESO</span><h2>Usuarios</h2></div></div><form method="POST" action="/usuarios/nuevo" class="maintenance-grid"><div><label>Nombre</label><input name="nombre" required></div><div><label>Usuario</label><input name="usuario" required autocomplete="off"></div><div><label>Contraseña</label><input name="password" type="password" minlength="8" required></div><div><label>Rol</label><select name="rol_id" required><% roles.filter(r=>['Administrador','Mecanico'].includes(r.nombre)).forEach(r=>{ %><option value="<%= r.id %>"><%= r.nombre==='Mecanico'?'Mecánico':r.nombre %></option><% }) %></select></div><button class="btn btn-danger">+ Crear usuario</button></form></section><section class="simple-sheet"><h3>Usuarios registrados</h3><% usuarios.forEach(u=>{ %><div class="history-line"><div><strong><%= u.nombre %></strong><span>@<%= u.usuario %> · <%= u.rolNombre %> <%= u.activo?'':'· Inactivo' %></span></div><div class="user-admin-actions"><button type="button" class="btn btn-sm btn-dark" onclick="document.getElementById('edit-user-<%= u.id %>').classList.toggle('show')">Editar</button><% if(u.activo){ %><form method="POST" action="/usuarios/<%= u.id %>/eliminar"><button class="btn btn-sm btn-outline-secondary">Desactivar</button></form><% } %></div></div><form id="edit-user-<%= u.id %>" class="user-inline-edit" method="POST" action="/usuarios/<%= u.id %>/editar"><div><label>Nombre</label><input name="nombre" value="<%= u.nombre %>" required></div><div><label>Usuario</label><input name="usuario" value="<%= u.usuario %>" required></div><div><label>Rol</label><select name="rol_id" required><% roles.filter(r=>['Administrador','Mecanico'].includes(r.nombre)).forEach(r=>{ %><option value="<%= r.id %>" <%= Number(r.id)===Number(u.rolId)?'selected':'' %>><%= r.nombre==='Mecanico'?'Mecánico':r.nombre %></option><% }) %></select></div><button class="btn btn-danger btn-sm">Guardar cambios</button></form><form class="user-password-admin" method="POST" action="/usuarios/<%= u.id %>/password"><div><label>Nueva contraseña</label><input name="password" type="password" minlength="8" autocomplete="new-password" required placeholder="Mínimo 8 caracteres"></div><div><label>Confirmar contraseña</label><input name="confirmar_password" type="password" minlength="8" autocomplete="new-password" required placeholder="Repita la contraseña"></div><button class="btn btn-dark btn-sm" type="submit">Cambiar contraseña</button></form><% }) %></section></div></div>