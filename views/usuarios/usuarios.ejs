<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>ACCESO</span><h2>Usuarios</h2></div></div><form method="POST" action="/usuarios/nuevo" class="maintenance-grid"><div><label>Nombre</label><input name="nombre" required></div><div><label>Usuario</label><input name="usuario" required autocomplete="off"></div><div><label>Contraseña</label><input name="password" type="password" minlength="8" required></div><div><label>Rol</label><select name="rol_id" required><% roles.filter(r=>['Administrador','Mecanico'].includes(r.nombre)).forEach(r=>{ %><option value="<%= r.id %>"><%= r.nombre==='Mecanico'?'Mecánico':r.nombre %></option><% }) %></select></div><button class="btn btn-danger">+ Crear usuario</button></form></section><section class="simple-sheet"><h3>Usuarios registrados</h3><% usuarios.forEach(u=>{ %><div class="history-line"><div><strong><%= u.nombre %></strong><span>@<%= u.usuario %> · <%= u.rolNombre %> <%= u.activo?'':'· Inactivo' %></span></div><% if(u.activo){ %><form method="POST" action="/usuarios/<%= u.id %>/eliminar"><button class="btn btn-sm btn-outline-secondary">Desactivar</button></form><% } %></div><% }) %></section></div></div>