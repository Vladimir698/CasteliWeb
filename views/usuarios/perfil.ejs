<% const nombre=String(usuario?.nombre||'Usuario'); const login=String(usuario?.usuario||''); %><div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="d-flex align-items-center" style="gap:18px"><div class="profile-avatar"><%= nombre.charAt(0).toUpperCase() %></div><div><span class="form-eyebrow">MI PERFIL</span><h3 class="mb-1"><%= nombre %></h3><p class="text-muted mb-1"><% if(login){ %>@<%= login %> · <% } %><%= usuario?.rol||'Sin rol' %></p><% if(!usuario?.esDesarrollo){ %><a href="/logout" class="btn btn-outline-danger mt-3">Cerrar sesión</a><% }else{ %><small class="text-muted">Modo de desarrollo</small><% } %></div></div></section></div></div>