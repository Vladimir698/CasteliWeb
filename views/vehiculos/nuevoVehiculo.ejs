<div class="content">
  <div class="container-fluid">

    <section class="responsive-form-card">

      <header class="responsive-form-header">
        <div>
          <span class="form-eyebrow">NUEVO VEHÍCULO</span>
          <h2>Registrar vehículo</h2>

          <p>
            Vehículo asociado a
            <strong><%= cliente?.nombre || 'cliente' %></strong>.
          </p>
        </div>

        <div class="d-none d-md-flex align-items-center">
          <i
            class="fa fa-car"
            aria-hidden="true"
            style="font-size: 42px; color: #d71920;"
          ></i>
        </div>
      </header>

      <% if (errores && errores.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <strong>No fue posible guardar el vehículo:</strong>

          <ul class="mb-0 mt-2">
            <% errores.forEach(error => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form
        action="/vehiculos/cliente/<%= cliente.id %>"
        method="POST"
        autocomplete="off"
      >
        <div class="responsive-form-grid">

          <div class="form-group">
            <label for="placa">
              Placa
              <span class="text-danger">*</span>
            </label>

            <input
              id="placa"
              name="placa"
              type="text"
              class="form-control text-uppercase"
              maxlength="20"
              value="<%= vehiculo?.placa || '' %>"
              placeholder="ABC-123"
              required
              autofocus
            >
          </div>

          <div class="form-group">
            <label for="kilometraje_actual">
              Kilometraje actual
            </label>

            <input
              id="kilometraje_actual"
              name="kilometraje_actual"
              type="number"
              class="form-control"
              min="0"
              step="1"
              inputmode="numeric"
              value="<%=
                vehiculo?.kilometraje_actual ??
                vehiculo?.kilometrajeActual ??
                ''
              %>"
              placeholder="Ejemplo: 125000"
            >
          </div>

          <div class="form-group">
            <label for="marca">
              Marca
              <span class="text-danger">*</span>
            </label>

            <input
              id="marca"
              name="marca"
              type="text"
              class="form-control"
              maxlength="80"
              value="<%= vehiculo?.marca || '' %>"
              placeholder="Toyota"
              required
            >
          </div>

          <div class="form-group">
            <label for="modelo">
              Modelo
              <span class="text-danger">*</span>
            </label>

            <input
              id="modelo"
              name="modelo"
              type="text"
              class="form-control"
              maxlength="80"
              value="<%= vehiculo?.modelo || '' %>"
              placeholder="Hilux"
              required
            >
          </div>

          <div class="form-group">
            <label for="anio">
              Año
            </label>

            <input
              id="anio"
              name="anio"
              type="number"
              class="form-control"
              min="1900"
              max="<%= new Date().getFullYear() + 1 %>"
              inputmode="numeric"
              value="<%= vehiculo?.anio || '' %>"
              placeholder="<%= new Date().getFullYear() %>"
            >
          </div>

          <div class="form-group">
            <label for="color">
              Color
            </label>

            <input
              id="color"
              name="color"
              type="text"
              class="form-control"
              maxlength="40"
              value="<%= vehiculo?.color || '' %>"
              placeholder="Blanco"
            >
          </div>

          <div class="form-group">
            <label for="vin">
              VIN o número de chasis
            </label>

            <input
              id="vin"
              name="vin"
              type="text"
              class="form-control text-uppercase"
              maxlength="50"
              value="<%= vehiculo?.vin || '' %>"
              placeholder="Número de identificación vehicular"
            >
          </div>

          <div class="form-group">
            <label for="numero_motor">
              Número de motor
            </label>

            <input
              id="numero_motor"
              name="numero_motor"
              type="text"
              class="form-control text-uppercase"
              maxlength="50"
              value="<%=
                vehiculo?.numero_motor ||
                vehiculo?.numeroMotor ||
                ''
              %>"
              placeholder="Número grabado en el motor"
            >
          </div>

          <div class="form-group">
            <label for="motor">
              Motor
            </label>

            <input
              id="motor"
              name="motor"
              type="text"
              class="form-control"
              maxlength="80"
              value="<%= vehiculo?.motor || '' %>"
              placeholder="Ejemplo: 2.7 gasolina"
            >
          </div>

          <div class="form-group">
            <label for="cilindraje">
              Cilindraje
            </label>

            <input
              id="cilindraje"
              name="cilindraje"
              type="text"
              class="form-control"
              maxlength="30"
              value="<%= vehiculo?.cilindraje || '' %>"
              placeholder="Ejemplo: 2700 cc"
            >
          </div>

          <div class="form-group">
            <label for="combustible">
              Combustible
            </label>

            <select
              id="combustible"
              name="combustible"
              class="form-control"
            >
              <option value="">Seleccione</option>

              <% [
                'Gasolina',
                'Diésel',
                'Híbrido',
                'Eléctrico',
                'Gas',
                'Otro'
              ].forEach(opcion => { %>
                <option
                  value="<%= opcion %>"
                  <%= vehiculo?.combustible === opcion
                    ? 'selected'
                    : ''
                  %>
                >
                  <%= opcion %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="transmision">
              Transmisión
            </label>

            <select
              id="transmision"
              name="transmision"
              class="form-control"
            >
              <option value="">Seleccione</option>

              <% [
                'Manual',
                'Automática',
                'CVT',
                'Doble embrague',
                'Otra'
              ].forEach(opcion => { %>
                <option
                  value="<%= opcion %>"
                  <%= vehiculo?.transmision === opcion
                    ? 'selected'
                    : ''
                  %>
                >
                  <%= opcion %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="traccion">
              Tracción
            </label>

            <select
              id="traccion"
              name="traccion"
              class="form-control"
            >
              <option value="">Seleccione</option>

              <% [
                '4x2',
                '4x4',
                'AWD',
                'Delantera',
                'Trasera',
                'Otra'
              ].forEach(opcion => { %>
                <option
                  value="<%= opcion %>"
                  <%= vehiculo?.traccion === opcion
                    ? 'selected'
                    : ''
                  %>
                >
                  <%= opcion %>
                </option>
              <% }) %>
            </select>
          </div>

        </div>

        <div class="responsive-form-actions">
          <a
            href="/clientes/<%= cliente.id %>"
            class="btn btn-outline-secondary"
          >
            <i class="fa fa-times" aria-hidden="true"></i>
            Cancelar
          </a>

          <button
            type="submit"
            class="btn btn-danger"
          >
            <i class="fa fa-save" aria-hidden="true"></i>
            Guardar vehículo
          </button>
        </div>
      </form>

    </section>

  </div>
</div>