<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><header class="simple-sheet-header"><div><span class="form-eyebrow">REGISTRO RÁPIDO</span><h2>Vehículo y propietario</h2><p>Solo la información necesaria para comenzar a trabajar.</p></div></header><% if(errores?.length){ %><div class="alert alert-danger"><% errores.forEach(e=>{ %><div><%= e %></div><% }) %></div><% } %><form action="/vehiculos" method="POST"><h4>Vehículo</h4><div class="simple-form-grid"><div><label>Placa *</label><input class="form-control" name="placa" value="<%= vehiculo.placa || '' %>" required></div><div><label>Kilometraje *</label><input class="form-control" type="number" min="0" name="kilometraje_actual" value="<%= vehiculo.kilometraje_actual ?? vehiculo.kilometrajeActual ?? 0 %>" required></div><div><label>Modelo *</label><input class="form-control" name="modelo" value="<%= vehiculo.modelo || '' %>" placeholder="Ej. Fortuner" required></div><div><label>Año</label><input class="form-control" type="number" name="anio" value="<%= vehiculo.anio || '' %>"></div></div><hr><h4>Propietario</h4><input type="hidden" name="cliente_id" id="cliente_id" value="<%= clienteSeleccionadoId || '' %>"><div id="clienteSeleccionado" class="selected-client <%= clienteSeleccionado ? '' : 'd-none' %>"><strong id="clienteNombre"><%= clienteSeleccionado?.nombre || '' %></strong><span id="clienteDatos"><%= clienteSeleccionado ? `${clienteSeleccionado.identificacion || ''} · ${clienteSeleccionado.telefono || ''}` : '' %></span><button type="button" class="btn btn-sm btn-outline-secondary" onclick="limpiarCliente()">Cambiar</button></div><div id="buscadorCliente" class="<%= clienteSeleccionado ? 'd-none' : '' %>"><label>Buscar cliente existente</label><input class="form-control" id="buscarCliente" placeholder="Nombre, identificación o teléfono" autocomplete="off"><div id="resultadosCliente" class="client-search-results"></div><p class="text-muted mt-2">Si no existe, complete los datos siguientes.</p></div><div id="nuevoCliente"><div class="simple-form-grid"><div><label>Tipo</label><select class="form-control" name="tipo_cliente" id="tipoCliente"><option value="persona">Persona</option><option value="empresa">Asociación / Sociedad Anónima</option></select></div><div><label>Nombre</label><input class="form-control" name="nombre_cliente"></div><div><label>Identificación</label><input class="form-control" name="identificacion_cliente"></div><div><label>Teléfono</label><input class="form-control" name="telefono_cliente"></div><div id="correoEmpresa" class="d-none"><label>Correo de empresa</label><input class="form-control" type="email" name="correo_cliente"></div><div id="codigoTrabajoEmpresa" class="d-none"><label>Código de trabajo</label><input class="form-control" name="codigo_trabajo" id="codigoTrabajo" placeholder="Código para facturación electrónica"><small class="text-muted">Se guarda con el propietario para reutilizarlo al facturar.</small></div></div></div><div class="simple-actions"><a href="/home" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-danger btn-lg">Guardar vehículo</button></div></form></section></div></div><script>
const input=document.getElementById('buscarCliente'),resultados=document.getElementById('resultadosCliente');let timer;input?.addEventListener('input',()=>{clearTimeout(timer);const q=input.value.trim();if(q.length<2){resultados.innerHTML='';return;}timer=setTimeout(async()=>{const r=await fetch('/vehiculos/buscar-clientes?q='+encodeURIComponent(q));const data=await r.json();resultados.innerHTML=data.map(c=>`<button type="button" class="client-result" data-id="${c.id}" data-name="${c.nombre}" data-info="${c.identificacion||''} · ${c.telefono||''}" data-type="${c.tipoCliente||'persona'}" data-code="${c.codigoTrabajo||''}"><strong>${c.nombre}</strong><span>${c.identificacion||''} · ${c.telefono||''}</span></button>`).join('');document.querySelectorAll('.client-result').forEach(b=>b.onclick=()=>seleccionar(b.dataset.id,b.dataset.name,b.dataset.info,b.dataset.type,b.dataset.code));},250);});function seleccionar(id,nombre,info,tipo,codigo){document.getElementById('cliente_id').value=id;document.getElementById('clienteNombre').textContent=nombre;document.getElementById('clienteDatos').textContent=info;document.getElementById('clienteSeleccionado').classList.remove('d-none');document.getElementById('buscadorCliente').classList.add('d-none');document.getElementById('nuevoCliente').classList.add('d-none');const bloque=document.getElementById('codigoTrabajoEmpresa');if(tipo==='empresa'){bloque.classList.remove('d-none');document.getElementById('codigoTrabajo').value=codigo||'';}else{bloque.classList.add('d-none');}}function limpiarCliente(){document.getElementById('cliente_id').value='';document.getElementById('clienteSeleccionado').classList.add('d-none');document.getElementById('buscadorCliente').classList.remove('d-none');document.getElementById('nuevoCliente').classList.remove('d-none');document.getElementById('codigoTrabajoEmpresa').classList.add('d-none');}document.getElementById('tipoCliente')?.addEventListener('change',e=>{const empresa=e.target.value==='empresa';document.getElementById('correoEmpresa').classList.toggle('d-none',!empresa);document.getElementById('codigoTrabajoEmpresa').classList.toggle('d-none',!empresa);});
</script>
