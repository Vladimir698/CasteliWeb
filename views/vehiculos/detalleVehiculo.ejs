<% const o=ordenActual;const rep=o?.repuestos||[];const trabajos=o?.trabajos||[];const detectados=trabajos.filter(x=>x.estado==='detectado');const realizados=trabajos.filter(x=>x.estado!=='detectado');const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0);const iva=subtotal*.13;const totalRepuestos=subtotal+iva;const mano=Number(o?.manoObra||0),otros=Number(o?.otros||0),dekra=Number(o?.descuento||0);const ivaTaller=(mano+otros)*.13;const total=o?Math.max(0,totalRepuestos+mano+otros+ivaTaller+dekra):0;const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});const yaEnRepuestos=d=>rep.some(r=>String(r.descripcion).trim().toLowerCase()===String(d).trim().toLowerCase()); %>
<div class="content"><div class="container-fluid casteli-simple-page"><section class="vehicle-sheet-hero"><div><span>FICHA DEL VEHÍCULO</span><h1><%= vehiculo.placa %></h1><p><%= vehiculo.modelo %> <%= vehiculo.anio||'' %></p></div><div><small>Propietario</small><strong><%= vehiculo.cliente?.nombre||'Sin propietario' %></strong><span><%= vehiculo.cliente?.telefono||'' %></span></div></section>
<section class="simple-sheet maintenance-smart" id="mantenimiento"><div class="sheet-title"><div><span>MANTENIMIENTO PROGRAMADO</span><h3>Mantenimiento</h3></div><span>Información permanente</span></div>
<div class="maintenance-current"><div><small>Kilometraje actual</small><strong><%= Number(vehiculo.kilometrajeActual||0).toLocaleString('es-CR') %> km</strong></div><div><small>Próximo aceite</small><strong><%= vehiculo.proximoAceiteKm ? Number(vehiculo.proximoAceiteKm).toLocaleString('es-CR')+' km' : 'Sin programar' %></strong><span><%= vehiculo.proximoAceiteFecha||'Sin fecha' %></span></div><div><small>Próxima revisión general</small><strong><%= vehiculo.proximaRevisionKm ? Number(vehiculo.proximaRevisionKm).toLocaleString('es-CR')+' km' : 'Sin programar' %></strong></div><div><small>Próximo líquido de frenos</small><strong><%= vehiculo.proximoFrenosFecha||'Sin programar' %></strong><span><%= vehiculo.ultimoFrenosFecha ? 'Último: '+vehiculo.ultimoFrenosFecha : 'Sin fecha anterior' %></span></div></div>
<button type="button" class="btn btn-dark maintenance-open" id="open-maintenance-modal"><i class="fa fa-calendar-check-o"></i> Actualizar mantenimiento</button>
<div class="maintenance-modal" id="maintenance-modal" aria-hidden="true"><div class="maintenance-modal-card"><div class="maintenance-modal-head"><div><span>PROGRAMAR PRÓXIMO SERVICIO</span><h3>¿Cada cuánto se realiza?</h3></div><button type="button" id="close-maintenance-modal" aria-label="Cerrar">×</button></div>
<form action="/vehiculos/<%= vehiculo.id %>/mantenimiento#mantenimiento" method="POST">
<div class="maintenance-question"><label>Kilometraje actual del vehículo</label><input id="m-km" type="number" min="0" name="kilometraje_actual" value="<%= vehiculo.kilometrajeActual||0 %>" required></div>
<div class="maintenance-question-block"><h4>Cambio de aceite</h4><div class="maintenance-question-grid"><div><label>¿Cada cuántos kilómetros?</label><input id="m-oil-km" type="number" min="1" name="intervalo_aceite_km" value="<%= vehiculo.intervaloAceiteKm||'' %>" placeholder="Ej. 6000"><small id="oil-km-preview"></small></div><div><label>Fecha del último cambio de aceite</label><input id="m-oil-date" type="date" name="ultimo_aceite_fecha" value="<%= vehiculo.ultimoAceiteFecha||'' %>"><small>Use la fecha en que realmente se hizo.</small></div><div><label>¿Cada cuántos meses?</label><input id="m-oil-months" type="number" min="1" name="intervalo_aceite_meses" value="<%= vehiculo.intervaloAceiteMeses||'' %>" placeholder="Ej. 6"><small id="oil-date-preview"></small></div></div></div>
<div class="maintenance-question-block"><h4>Revisión general</h4><div class="maintenance-question-grid"><div><label>Kilometraje de la última revisión</label><input id="m-review-last" type="number" min="0" name="ultima_revision_km" value="<%= vehiculo.ultimaRevisionKm??vehiculo.kilometrajeActual??'' %>" placeholder="Ej. 24000"></div><div><label>¿Cada cuántos kilómetros?</label><input id="m-review-km" type="number" min="1" name="intervalo_revision_km" value="<%= vehiculo.intervaloRevisionKm||'' %>" placeholder="Ej. 12000"><small id="review-km-preview"></small></div></div></div>
<div class="maintenance-question-block"><h4>Líquido de frenos</h4><div class="maintenance-question-grid one"><div><label>Fecha del último cambio</label><input id="m-brake-date" type="date" name="ultimo_frenos_fecha" value="<%= vehiculo.ultimoFrenosFecha||'' %>"><small id="brake-date-preview">El próximo cambio se calcula 1 año después.</small></div></div></div>
<div class="maintenance-modal-actions"><button type="button" class="btn btn-outline-secondary" id="cancel-maintenance-modal">Cancelar</button><button class="btn btn-danger">Calcular y guardar</button></div></form></div></div></section>
<script>(()=>{const modal=document.getElementById('maintenance-modal'),open=document.getElementById('open-maintenance-modal'),close=document.getElementById('close-maintenance-modal'),cancel=document.getElementById('cancel-maintenance-modal');if(!modal)return;const show=()=>{modal.classList.add('show');modal.setAttribute('aria-hidden','false');document.body.classList.add('maintenance-modal-open');preview()};const hide=()=>{modal.classList.remove('show');modal.setAttribute('aria-hidden','true');document.body.classList.remove('maintenance-modal-open')};open?.addEventListener('click',show);close?.addEventListener('click',hide);cancel?.addEventListener('click',hide);modal.addEventListener('click',e=>{if(e.target===modal)hide()});const addMonths=(value,m)=>{if(!value||!m)return '';const d=new Date(value+'T12:00:00');d.setMonth(d.getMonth()+Number(m));return d.toLocaleDateString('es-CR')};function preview(){const km=Number(document.getElementById('m-km').value||0),oil=Number(document.getElementById('m-oil-km').value||0),om=Number(document.getElementById('m-oil-months').value||0),od=document.getElementById('m-oil-date').value,bd=document.getElementById('m-brake-date').value,rl=Number(document.getElementById('m-review-last').value||0),ri=Number(document.getElementById('m-review-km').value||0);document.getElementById('oil-km-preview').textContent=oil?'Próximo: '+(km+oil).toLocaleString('es-CR')+' km':'';document.getElementById('oil-date-preview').textContent=od&&om?'Próximo: '+addMonths(od,om):'Ingrese la fecha del último cambio';document.getElementById('brake-date-preview').textContent=bd?'Próximo: '+addMonths(bd,12)+' (1 año después)':'Ingrese la fecha del último cambio';document.getElementById('review-km-preview').textContent=ri?'Próxima: '+(rl+ri).toLocaleString('es-CR')+' km':''}['m-km','m-oil-km','m-oil-months','m-oil-date','m-brake-date','m-review-last','m-review-km'].forEach(id=>document.getElementById(id)?.addEventListener('input',preview))})();</script>
<% if(!o){ %><section class="simple-sheet text-center empty-repair-actions"><h3>No hay reparación actual</h3><p class="text-muted">Puede iniciar una reparación o preparar primero una cotización para el cliente.</p><div class="empty-repair-buttons"><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger btn-lg">+ Nueva reparación</a><% if(esAdmin){ %><form action="/ordenes/vehiculo/<%= vehiculo.id %>/cotizacion" method="POST"><button type="submit" class="btn btn-dark btn-lg"><i class="fa fa-file-text-o"></i> Cotización</button></form><% } %></div></section><% }else{ %>
<section class="simple-sheet current-order-overview" id="reparacion-actual"><div class="current-order-head"><div><span class="form-eyebrow">REPARACIÓN ACTUAL</span><h3><%= o.numeroOrden %></h3><p><%= o.tipoServicio==='aceite'?'Cambio de aceite rápido':'Reparación / revisión' %></p></div><span class="current-order-state"><%= o.estado?.nombre||'' %></span></div><div class="repair-summary"><div><span>Ingreso</span><strong><%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></strong></div><div><span>Kilometraje</span><strong><%= Number(o.kilometrajeIngreso).toLocaleString('es-CR') %> km</strong></div><div class="wide"><span>Motivo de ingreso</span><strong><%= o.problemaReportado %></strong><% if(o.observaciones){ %><p><%= o.observaciones %></p><% } %></div></div><nav class="order-jump-nav"><a href="#lista-reparacion"><i class="fa fa-list"></i> Pendientes <b><%= detectados.length %></b></a><a href="#trabajo-realizado"><i class="fa fa-check"></i> Realizados <b><%= realizados.length %></b></a><% if(esAdmin){ %><a href="#repuestos"><i class="fa fa-cog"></i> Repuestos <b><%= rep.length %></b></a><a href="#cuenta-taller"><i class="fa fa-money"></i> Cobro</a><% } %><a href="#finalizar-reparacion"><i class="fa fa-flag-checkered"></i> Finalizar</a></nav><% if(esAdmin){ %><details class="order-admin-tools"><summary>Opciones de la orden</summary><div><form action="/ordenes/<%= o.id %>/cancelar" method="POST" onsubmit="return confirm('¿Cancelar esta orden? Se eliminará completamente, incluyendo trabajos y repuestos, y no aparecerá en el historial.')"><button class="btn btn-outline-danger btn-sm">Cancelar orden</button></form><form action="/ordenes/<%= o.id %>/limpiar-detalle" method="POST" onsubmit="return confirm('Esto eliminará la lista de reparación, trabajos realizados, repuestos y montos de esta reparación. ¿Continuar?')"><button class="btn btn-outline-secondary btn-sm">Limpiar detalle</button></form></div></details><% } %></section>
<section class="simple-sheet workshop-list" id="lista-reparacion"><div class="sheet-title"><div><span>AYUDANTES DE TALLER</span><h3>Lista de reparación</h3></div><span><%= detectados.length %> pendiente(s)</span></div><p class="text-muted">Toque una tarea cuando esté terminada. Se moverá automáticamente a Trabajo realizado.</p><div class="mechanic-checklist"><% detectados.forEach(x=>{ %><div class="work-edit-row"><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form" data-preserve-scroll><input type="hidden" name="realizado" value="1"><button type="submit" class="mechanic-item mechanic-item-button"><span class="mechanic-checkbox"></span><strong><%= x.descripcion %></strong><small>Marcar realizado</small></button></form><div class="work-item-actions"><% if(esAdmin){ %><details class="admin-work-edit"><summary><i class="fa fa-pencil"></i> Editar</summary><form action="/ordenes/trabajos/<%= x.id %>/editar" method="POST" data-preserve-scroll><input name="descripcion" value="<%= x.descripcion %>" required><button class="btn btn-dark btn-sm">Guardar</button></form></details><% } %><form action="/ordenes/trabajos/<%= x.id %>/eliminar" method="POST" class="remove-work-form" data-preserve-scroll onsubmit="return confirm('¿Quitar este elemento de la reparación?')"><button type="submit" class="work-remove-button"><i class="fa fa-trash-o"></i> Quitar</button></form></div></div><% }) %></div><form action="/ordenes/<%= o.id %>/trabajos" method="POST" data-preserve-scroll><input type="hidden" name="tipo" value="detectado"><textarea name="descripcion" rows="6" class="mechanic-list-input" placeholder="Una reparación por línea..." required></textarea><div class="section-actions"><button class="btn btn-danger btn-lg">+ Agregar a la lista</button><button type="submit" form="clear-work-form" class="btn btn-outline-secondary">Limpiar lista y trabajos</button></div></form><form id="clear-work-form" action="/ordenes/<%= o.id %>/limpiar-trabajos" method="POST" onsubmit="return confirm('¿Eliminar toda la lista de reparación y los trabajos realizados?')"></form></section>
<section class="simple-sheet" id="trabajo-realizado"><div class="sheet-title"><h3>Trabajo realizado</h3><span><%= realizados.length %> realizado(s)</span></div><div class="mechanic-checklist completed"><% realizados.forEach(x=>{ %><div class="work-edit-row"><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form" data-preserve-scroll><input type="hidden" name="realizado" value="0"><button class="mechanic-item mechanic-item-button completed" type="submit"><span class="mechanic-checkbox checked">✓</span><strong><%= x.descripcion %></strong><small>Deshacer</small></button></form><div class="work-item-actions"><% if(esAdmin){ %><details class="admin-work-edit"><summary><i class="fa fa-pencil"></i> Editar</summary><form action="/ordenes/trabajos/<%= x.id %>/editar" method="POST" data-preserve-scroll><input name="descripcion" value="<%= x.descripcion %>" required><button class="btn btn-dark btn-sm">Guardar</button></form></details><% } %><form action="/ordenes/trabajos/<%= x.id %>/eliminar" method="POST" class="remove-work-form" data-preserve-scroll onsubmit="return confirm('¿Quitar este elemento de la reparación?')"><button type="submit" class="work-remove-button"><i class="fa fa-trash-o"></i> Quitar</button></form></div></div><% }) %></div><details class="manual-work"><summary>Agregar un trabajo que no estaba en la lista</summary><form action="/ordenes/<%= o.id %>/trabajos" method="POST" data-preserve-scroll class="quick-row"><input type="hidden" name="tipo" value="realizado"><input name="descripcion" placeholder="Trabajo adicional realizado" required><button class="btn btn-dark">+ Agregar</button></form></details></section>
<% if(esAdmin){ %><section class="simple-sheet" id="repuestos"><div class="sheet-title"><div><span>COBRO</span><h3>Repuestos y materiales</h3></div><span><%= rep.length %> agregado(s)</span></div><p class="text-muted">Seleccione de la lista lo que corresponda a un repuesto o material. Después puede cambiar descripción, cantidad y precio.</p><div class="parts-from-work"><% trabajos.forEach(x=>{const usado=yaEnRepuestos(x.descripcion);%><form action="/ordenes/trabajos/<%= x.id %>/repuesto" method="POST" data-preserve-scroll><button class="part-pick <%= usado?'selected':'' %>" type="submit" <%= usado?'disabled':'' %>><span class="mechanic-checkbox <%= usado?'checked':'' %>"><%= usado?'✓':'+' %></span><span><strong><%= x.descripcion %></strong><small><%= x.estado==='realizado'?'Trabajo realizado':'Pendiente' %></small></span><b><%= usado?'Agregado':'Usar como repuesto' %></b></button></form><% }) %></div><% if(rep.length){ %><div class="parts-edit-list"><div class="parts-edit-head"><span>Descripción</span><span>Cantidad</span><span>Precio unitario</span><span>Total</span><span></span></div><% rep.forEach(x=>{const t=Number(x.cantidad)*Number(x.precio);%><form action="/ordenes/repuestos/<%= x.id %>/editar" method="POST" class="parts-edit-row"><input name="descripcion" value="<%= x.descripcion %>" required><input type="number" min="0.01" step="0.01" name="cantidad" value="<%= x.cantidad %>" required><input type="number" min="0" step="0.01" name="precio" value="<%= x.precio %>" required><strong><%= money(t) %></strong><button class="btn btn-dark btn-sm">Guardar</button></form><% }) %></div><% }else{ %><p class="empty-inline">Aún no hay repuestos agregados.</p><% } %><details class="manual-work"><summary>Agregar otro repuesto o material manualmente</summary><form action="/ordenes/<%= o.id %>/repuestos" method="POST" data-preserve-scroll class="parts-row"><input name="descripcion" placeholder="Repuesto o material" required><input type="number" min="0.01" step=".01" name="cantidad" value="1" required><input type="number" min="0" step=".01" name="precio" placeholder="Precio venta" required><button class="btn btn-dark">+ Agregar</button></form></details><div class="cost-box"><div><span>Subtotal</span><strong><%= money(subtotal) %></strong></div><div><span>IVA 13%</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(totalRepuestos) %></strong></div></div></section>
<section class="simple-sheet" id="cuenta-taller"><div class="sheet-title"><h3>Cuenta del taller</h3><form action="/ordenes/<%= o.id %>/limpiar-cobro" method="POST" onsubmit="return confirm('¿Eliminar todos los repuestos y poner los montos del taller en cero?')"><button class="btn btn-outline-danger btn-sm">Limpiar cobro</button></form></div><form action="/ordenes/<%= o.id %>/totales" method="POST" data-preserve-scroll class="totals-grid"><div><label>Mano de obra / servicios</label><input type="number" step=".01" name="mano_obra" value="<%= o.manoObra||0 %>"></div><div><label>Otros</label><input type="number" step=".01" name="otros" value="<%= o.otros||0 %>"></div><div><label>Factura de DEKRA</label><input type="number" min="0" step=".01" name="dekra" value="<%= o.descuento||0 %>"></div><button class="btn btn-dark">Guardar</button></form><div class="cost-box"><div><span>Servicio de taller</span><strong><%= money(mano+otros) %></strong></div><div><span>IVA servicio de taller 13%</span><strong><%= money(ivaTaller) %></strong></div></div><div class="grand-total"><span>TOTAL</span><strong><%= money(total) %></strong></div></section><% } %>

<% if(esAdmin){ %><section class="simple-sheet client-advance" id="adelanto-cliente"><div class="sheet-title"><div><span>PARA ENVIAR AL CLIENTE</span><h3>Detalle / adelanto de reparación</h3></div></div><p class="text-muted">El sistema prepara el detalle con lo realizado, repuestos y cobro. Puede modificar el texto antes de descargar la imagen.</p><label class="client-note-label" for="client-note">Nota o detalle adicional</label><textarea id="client-note" class="mechanic-list-input client-note" rows="4" placeholder="Ejemplo: Se realizó revisión general y se recomienda revisar nuevamente en el próximo mantenimiento."></textarea><div id="advance-preview" class="advance-preview"><div class="advance-brand"><strong>CASTELI</strong><span>Detalle de reparación</span></div><div class="advance-vehicle"><strong><%= vehiculo.placa %> · <%= vehiculo.modelo %> <%= vehiculo.anio||'' %></strong><span><%= vehiculo.cliente?.nombre||'' %></span></div><% if(realizados.length){ %><h4>Trabajos realizados</h4><ul><% realizados.forEach(x=>{ %><li><%= x.descripcion %></li><% }) %></ul><% } %><% if(rep.length){ %><h4>Repuestos y materiales</h4><% rep.forEach(x=>{ %><div class="advance-line"><span><%= x.descripcion %> × <%= x.cantidad %></span><strong><%= money(Number(x.cantidad)*Number(x.precio)) %></strong></div><% }) %><div class="advance-line muted"><span>IVA repuestos</span><strong><%= money(iva) %></strong></div><% } %><h4>Servicios de taller</h4><div class="advance-line"><span>Mano de obra / servicios</span><strong><%= money(mano) %></strong></div><% if(otros){ %><div class="advance-line"><span>Otros</span><strong><%= money(otros) %></strong></div><% } %><div class="advance-line muted"><span>IVA servicio de taller (13 %)</span><strong><%= money(ivaTaller) %></strong></div><% if(dekra){ %><div class="advance-line"><span>Factura de DEKRA</span><strong><%= money(dekra) %></strong></div><% } %><div class="advance-total"><span>Total estimado</span><strong><%= money(total) %></strong></div><p class="advance-note-preview" id="advance-note-preview"></p></div><button type="button" id="download-advance" class="btn btn-danger btn-lg">Descargar imagen para el cliente</button></section>
<% } %><section class="simple-sheet" id="finalizar-reparacion"><% if(esAdmin){ %><div class="sheet-title"><div><span>CIERRE ADMINISTRATIVO</span><h3>Revisar y cerrar reparación</h3></div></div><% if(o.estado?.nombre==='Pendiente de cierre'){ %><div class="mechanic-ready-alert"><i class="fa fa-bell"></i><div><strong><%= o.responsableTrabajo %> indicó que terminó la reparación</strong><span>Revise el detalle, repuestos y cobro antes de cerrar. <%= String(o.responsableTrabajo||'').toLowerCase()==='emerson'?'El servicio de taller se asignará a Emerson en Facturación Quincenal.':'El servicio de taller se contabilizará como Taller.' %></span></div></div><% }else{ %><p class="text-muted">Cuando todo esté revisado puede cerrar la orden. Si no fue reportada por un mecánico, el servicio se contabilizará como Taller.</p><% } %><form action="/ordenes/<%= o.id %>/finalizar" method="POST" class="finalize-repair-form admin-finalize" onsubmit="return confirm('¿Confirma el cierre administrativo? La orden saldrá de reparaciones activas y pasará a Facturación Quincenal.')"><div><label>Destino del servicio</label><strong><%= o.estado?.nombre==='Pendiente de cierre' && String(o.responsableTrabajo||'').toLowerCase()==='emerson' ? 'Emerson · Servicios profesionales' : 'Taller' %></strong><small><%= o.estado?.nombre==='Pendiente de cierre' ? 'Reportado por '+o.responsableTrabajo : 'Cierre realizado por administración' %></small></div><button type="submit" class="btn btn-success btn-lg">✓ Cerrar reparación</button></form><% }else{ %><div class="sheet-title"><div><span>TRABAJO TERMINADO</span><h3>Avisar a administración</h3></div></div><% if(o.estado?.nombre==='Pendiente de cierre'){ %><div class="mechanic-ready-confirm"><i class="fa fa-check-circle"></i><div><strong>Ya avisó que terminó esta reparación</strong><span>La orden seguirá visible hasta que un administrador revise el cobro y la cierre.</span></div></div><% }else{ %><p class="text-muted">Cuando termine su trabajo, avise a administración. Esto no cierra la orden ni la elimina de la lista.</p><form action="/ordenes/<%= o.id %>/reportar-terminado" method="POST" onsubmit="return confirm('¿Confirma que terminó su trabajo en este vehículo? Administración recibirá el aviso para revisar y cerrar la orden.')"><button type="submit" class="btn btn-success btn-lg">✓ Mi trabajo está terminado</button></form><% } %><% } %></section><% } %><section class="simple-sheet" id="historial"><div class="sheet-title"><div><span>REGISTRO DEL VEHÍCULO</span><h3>Historial de visitas</h3></div><span><%= ordenes.length %> registro(s)</span></div><p class="text-muted">Abra cualquier visita para consultar trabajos, repuestos, cobros y quién realizó la reparación.</p><div class="visit-history-list"><% ordenes.forEach(x=>{ %><a href="/ordenes/<%= x.id %>" class="history-line history-link"><div><strong><%= x.numeroOrden %></strong><span><%= new Date(x.fechaRecepcion).toLocaleDateString('es-CR') %> · <%= Number(x.kilometrajeIngreso).toLocaleString('es-CR') %> km · <%= x.problemaReportado %></span></div><div class="history-link-status"><span><%= x.estado?.nombre||'' %></span><i class="fa fa-chevron-right"></i></div></a><% }) %></div></section><div class="simple-actions"><a href="/ordenes" class="btn btn-outline-secondary">Lista de reparaciones</a><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger">+ Nueva reparación</a></div></div></div>
