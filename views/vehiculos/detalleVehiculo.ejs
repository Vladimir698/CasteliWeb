<% const o=ordenActual;const rep=o?.repuestos||[];const trabajos=o?.trabajos||[];const detectados=trabajos.filter(x=>x.estado==='detectado');const realizados=trabajos.filter(x=>x.estado!=='detectado');const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0);const iva=subtotal*.13;const totalRepuestos=subtotal+iva;const total=o?Math.max(0,totalRepuestos+Number(o.manoObra||0)+Number(o.otros||0)-Number(o.descuento||0)):0;const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2}); %>
<div class="content"><div class="container-fluid casteli-simple-page">
<section class="vehicle-sheet-hero"><div><span>FICHA DEL VEHÍCULO</span><h1><%= vehiculo.placa %></h1><p><%= vehiculo.modelo %> <%= vehiculo.anio||'' %></p></div><div><small>Propietario</small><strong><%= vehiculo.cliente?.nombre||'Sin propietario' %></strong><span><%= vehiculo.cliente?.telefono||'' %></span></div></section>
<section class="simple-sheet"><div class="sheet-title"><h3>Mantenimiento</h3><span>Información permanente del vehículo</span></div><form action="/vehiculos/<%= vehiculo.id %>/mantenimiento#reparacion-actual" method="POST" class="maintenance-grid"><div><label>Kilometraje actual</label><input type="number" name="kilometraje_actual" value="<%= vehiculo.kilometrajeActual||0 %>"></div><div><label>Próximo aceite (km)</label><input type="number" name="proximo_aceite_km" value="<%= vehiculo.proximoAceiteKm||'' %>"></div><div><label>Próximo aceite (fecha)</label><input type="date" name="proximo_aceite_fecha" value="<%= vehiculo.proximoAceiteFecha||'' %>"></div><div><label>Próximo líquido de frenos</label><input type="date" name="proximo_frenos_fecha" value="<%= vehiculo.proximoFrenosFecha||'' %>"></div><button class="btn btn-dark">Guardar</button></form></section>
<% if(!o){ %><section class="simple-sheet text-center"><h3>No hay reparación actual</h3><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger btn-lg">+ Nueva reparación</a></section><% }else{ %>
<section class="simple-sheet" id="reparacion-actual"><div class="sheet-title"><div><span>REPARACIÓN ACTUAL</span><h3><%= o.numeroOrden %></h3></div><strong><%= o.estado?.nombre||'' %></strong></div><div class="repair-summary"><div><span>Ingreso</span><strong><%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></strong></div><div><span>Kilometraje</span><strong><%= Number(o.kilometrajeIngreso).toLocaleString('es-CR') %> km</strong></div><div class="wide"><span>Lo indicado al recibir el vehículo</span><strong><%= o.problemaReportado %></strong><% if(o.observaciones){ %><p><%= o.observaciones %></p><% } %></div></div></section>
<section class="simple-sheet workshop-list" id="lista-reparacion"><div class="sheet-title"><div><span>AYUDANTES DE TALLER</span><h3>Lista de reparación</h3></div><span><%= detectados.length %> pendiente(s)</span></div><p class="text-muted">Escriba una cosa por línea. Puede pegar directamente el mensaje del taller y guardar toda la lista de una vez.</p><% if(detectados.length){ %><div class="mechanic-checklist"><% detectados.forEach(x=>{ %><div class="mechanic-item"><span class="mechanic-bullet"></span><strong><%= x.descripcion %></strong></div><% }) %></div><% }else{ %><p class="empty-inline">Todavía no se ha agregado nada a la lista.</p><% } %><form action="/ordenes/<%= o.id %>/trabajos" method="POST"><input type="hidden" name="tipo" value="detectado"><textarea name="descripcion" rows="7" class="mechanic-list-input" placeholder="Rótulas de estabilizadora trasera&#10;Fibras traseras&#10;Fuga de aceite (tapa válvulas)&#10;Hules de soporte superior de Camber&#10;Pulir focos&#10;Filtro de aire&#10;Filtro de cabina" required></textarea><button class="btn btn-danger btn-lg mt-2">+ Agregar a la lista</button></form></section>
<section class="simple-sheet" id="trabajo-realizado"><div class="sheet-title"><h3>Trabajo realizado</h3><span><%= realizados.length %> realizado(s)</span></div><% realizados.forEach(x=>{ %><div class="work-line">✓ <%= x.descripcion %></div><% }) %><form action="/ordenes/<%= o.id %>/trabajos" method="POST" class="quick-row"><input type="hidden" name="tipo" value="realizado"><input name="descripcion" placeholder="Trabajo que se realizó" required><button class="btn btn-dark">+ Agregar</button></form></section>
<section class="simple-sheet" id="repuestos"><h3>Repuestos y materiales</h3><div class="table-responsive"><table class="table simple-cost-table"><thead><tr><th>Descripción</th><th>Cant.</th><th>Precio</th><th>Total</th></tr></thead><tbody><% rep.forEach(x=>{const t=Number(x.cantidad)*Number(x.precio);%><tr><td><%= x.descripcion %></td><td><%= x.cantidad %></td><td><%= money(x.precio) %></td><td><strong><%= money(t) %></strong></td></tr><% }) %></tbody></table></div><form action="/ordenes/<%= o.id %>/repuestos" method="POST" class="parts-row"><input name="descripcion" placeholder="Repuesto o material" required><input type="number" step=".01" name="cantidad" value="1" required><input type="number" step=".01" name="precio" placeholder="Precio venta" required><button class="btn btn-dark">+ Agregar</button></form><div class="cost-box"><div><span>Subtotal</span><strong><%= money(subtotal) %></strong></div><div><span>IVA 13%</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(totalRepuestos) %></strong></div></div></section>
<section class="simple-sheet" id="cuenta-taller"><h3>Cuenta del taller</h3><form action="/ordenes/<%= o.id %>/totales" method="POST" class="totals-grid"><div><label>Mano de obra</label><input type="number" step=".01" name="mano_obra" value="<%= o.manoObra||0 %>"></div><div><label>Otros</label><input type="number" step=".01" name="otros" value="<%= o.otros||0 %>"></div><div><label>Descuento</label><input type="number" step=".01" name="descuento" value="<%= o.descuento||0 %>"></div><button class="btn btn-dark">Guardar</button></form><div class="grand-total"><span>TOTAL</span><strong><%= money(total) %></strong></div></section><% } %>
<section class="simple-sheet"><div class="sheet-title"><h3>Historial de visitas</h3><span><%= ordenes.length %> registro(s)</span></div><% ordenes.forEach(x=>{ %><div class="history-line"><div><strong><%= x.numeroOrden %></strong><span><%= new Date(x.fechaRecepcion).toLocaleDateString('es-CR') %> · <%= Number(x.kilometrajeIngreso).toLocaleString('es-CR') %> km · <%= x.problemaReportado %></span></div><span><%= x.estado?.nombre||'' %></span></div><% }) %></section>
<div class="simple-actions"><a href="/ordenes" class="btn btn-outline-secondary">Lista de reparaciones</a><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger">+ Nueva reparación</a></div></div></div>