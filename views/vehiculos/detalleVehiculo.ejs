<% const o=ordenActual;const rep=o?.repuestos||[];const trabajos=o?.trabajos||[];const detectados=trabajos.filter(x=>x.estado==='detectado');const realizados=trabajos.filter(x=>x.estado!=='detectado');const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0);const iva=subtotal*.13;const totalRepuestos=subtotal+iva;const mano=Number(o?.manoObra||0),otros=Number(o?.otros||0),descuento=Number(o?.descuento||0);const total=o?Math.max(0,totalRepuestos+mano+otros-descuento):0;const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});const yaEnRepuestos=d=>rep.some(r=>String(r.descripcion).trim().toLowerCase()===String(d).trim().toLowerCase()); %>
<div class="content"><div class="container-fluid casteli-simple-page"><section class="vehicle-sheet-hero"><div><span>FICHA DEL VEHÍCULO</span><h1><%= vehiculo.placa %></h1><p><%= vehiculo.modelo %> <%= vehiculo.anio||'' %></p></div><div><small>Propietario</small><strong><%= vehiculo.cliente?.nombre||'Sin propietario' %></strong><span><%= vehiculo.cliente?.telefono||'' %></span></div></section>
<section class="simple-sheet"><div class="sheet-title"><h3>Mantenimiento</h3><span>Información permanente</span></div><form action="/vehiculos/<%= vehiculo.id %>/mantenimiento#reparacion-actual" method="POST" class="maintenance-grid"><div><label>Kilometraje actual</label><input type="number" name="kilometraje_actual" value="<%= vehiculo.kilometrajeActual||0 %>"></div><div><label>Próximo aceite (km)</label><input type="number" name="proximo_aceite_km" value="<%= vehiculo.proximoAceiteKm||'' %>"></div><div><label>Próximo aceite (fecha)</label><input type="date" name="proximo_aceite_fecha" value="<%= vehiculo.proximoAceiteFecha||'' %>"></div><div><label>Próximo líquido de frenos</label><input type="date" name="proximo_frenos_fecha" value="<%= vehiculo.proximoFrenosFecha||'' %>"></div><button class="btn btn-dark">Guardar</button></form></section>
<% if(!o){ %><section class="simple-sheet text-center"><h3>No hay reparación actual</h3><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger btn-lg">+ Nueva reparación</a></section><% }else{ %>
<section class="simple-sheet" id="reparacion-actual"><div class="sheet-title"><div><span>REPARACIÓN ACTUAL</span><h3><%= o.numeroOrden %></h3></div><strong><%= o.estado?.nombre||'' %></strong></div><div class="repair-summary"><div><span>Ingreso</span><strong><%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></strong></div><div><span>Kilometraje</span><strong><%= Number(o.kilometrajeIngreso).toLocaleString('es-CR') %> km</strong></div><div class="wide"><span>Motivo de ingreso</span><strong><%= o.problemaReportado %></strong><% if(o.observaciones){ %><p><%= o.observaciones %></p><% } %></div></div><div class="danger-zone"><span>¿El detalle se preparó para el vehículo equivocado?</span><form action="/ordenes/<%= o.id %>/limpiar-detalle" method="POST" onsubmit="return confirm('Esto eliminará la lista de reparación, trabajos realizados, repuestos y montos de esta reparación. ¿Continuar?')"><button class="btn btn-outline-danger btn-sm">Limpiar todo el detalle</button></form></div></section>
<section class="simple-sheet workshop-list" id="lista-reparacion"><div class="sheet-title"><div><span>AYUDANTES DE TALLER</span><h3>Lista de reparación</h3></div><span><%= detectados.length %> pendiente(s)</span></div><p class="text-muted">Toque una tarea cuando esté terminada. Se moverá automáticamente a Trabajo realizado.</p><div class="mechanic-checklist"><% detectados.forEach(x=>{ %><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form"><input type="hidden" name="realizado" value="1"><button type="submit" class="mechanic-item mechanic-item-button"><span class="mechanic-checkbox"></span><strong><%= x.descripcion %></strong><small>Marcar realizado</small></button></form><% }) %></div><form action="/ordenes/<%= o.id %>/trabajos" method="POST"><input type="hidden" name="tipo" value="detectado"><textarea name="descripcion" rows="6" class="mechanic-list-input" placeholder="Una reparación por línea..." required></textarea><div class="section-actions"><button class="btn btn-danger btn-lg">+ Agregar a la lista</button><button type="submit" form="clear-work-form" class="btn btn-outline-secondary">Limpiar lista y trabajos</button></div></form><form id="clear-work-form" action="/ordenes/<%= o.id %>/limpiar-trabajos" method="POST" onsubmit="return confirm('¿Eliminar toda la lista de reparación y los trabajos realizados?')"></form></section>
<section class="simple-sheet" id="trabajo-realizado"><div class="sheet-title"><h3>Trabajo realizado</h3><span><%= realizados.length %> realizado(s)</span></div><div class="mechanic-checklist completed"><% realizados.forEach(x=>{ %><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form"><input type="hidden" name="realizado" value="0"><button class="mechanic-item mechanic-item-button completed" type="submit"><span class="mechanic-checkbox checked">✓</span><strong><%= x.descripcion %></strong><small>Deshacer</small></button></form><% }) %></div><details class="manual-work"><summary>Agregar un trabajo que no estaba en la lista</summary><form action="/ordenes/<%= o.id %>/trabajos" method="POST" class="quick-row"><input type="hidden" name="tipo" value="realizado"><input name="descripcion" placeholder="Trabajo adicional realizado" required><button class="btn btn-dark">+ Agregar</button></form></details></section>
<section class="simple-sheet" id="repuestos"><div class="sheet-title"><div><span>COBRO</span><h3>Repuestos y materiales</h3></div><span><%= rep.length %> agregado(s)</span></div><p class="text-muted">Seleccione de la lista lo que corresponda a un repuesto o material. Después puede cambiar descripción, cantidad y precio.</p><div class="parts-from-work"><% trabajos.forEach(x=>{const usado=yaEnRepuestos(x.descripcion);%><form action="/ordenes/trabajos/<%= x.id %>/repuesto" method="POST"><button class="part-pick <%= usado?'selected':'' %>" type="submit" <%= usado?'disabled':'' %>><span class="mechanic-checkbox <%= usado?'checked':'' %>"><%= usado?'✓':'+' %></span><span><strong><%= x.descripcion %></strong><small><%= x.estado==='realizado'?'Trabajo realizado':'Pendiente' %></small></span><b><%= usado?'Agregado':'Usar como repuesto' %></b></button></form><% }) %></div><% if(rep.length){ %><div class="parts-edit-list"><div class="parts-edit-head"><span>Descripción</span><span>Cantidad</span><span>Precio unitario</span><span>Total</span><span></span></div><% rep.forEach(x=>{const t=Number(x.cantidad)*Number(x.precio);%><form action="/ordenes/repuestos/<%= x.id %>/editar" method="POST" class="parts-edit-row"><input name="descripcion" value="<%= x.descripcion %>" required><input type="number" min="0.01" step="0.01" name="cantidad" value="<%= x.cantidad %>" required><input type="number" min="0" step="0.01" name="precio" value="<%= x.precio %>" required><strong><%= money(t) %></strong><button class="btn btn-dark btn-sm">Guardar</button></form><% }) %></div><% }else{ %><p class="empty-inline">Aún no hay repuestos agregados.</p><% } %><details class="manual-work"><summary>Agregar otro repuesto o material manualmente</summary><form action="/ordenes/<%= o.id %>/repuestos" method="POST" class="parts-row"><input name="descripcion" placeholder="Repuesto o material" required><input type="number" min="0.01" step=".01" name="cantidad" value="1" required><input type="number" min="0" step=".01" name="precio" placeholder="Precio venta" required><button class="btn btn-dark">+ Agregar</button></form></details><div class="cost-box"><div><span>Subtotal</span><strong><%= money(subtotal) %></strong></div><div><span>IVA 13%</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(totalRepuestos) %></strong></div></div></section>
<section class="simple-sheet" id="cuenta-taller"><div class="sheet-title"><h3>Cuenta del taller</h3><form action="/ordenes/<%= o.id %>/limpiar-cobro" method="POST" onsubmit="return confirm('¿Eliminar todos los repuestos y poner los montos del taller en cero?')"><button class="btn btn-outline-danger btn-sm">Limpiar cobro</button></form></div><form action="/ordenes/<%= o.id %>/totales" method="POST" class="totals-grid"><div><label>Mano de obra / servicios</label><input type="number" step=".01" name="mano_obra" value="<%= o.manoObra||0 %>"></div><div><label>Otros</label><input type="number" step=".01" name="otros" value="<%= o.otros||0 %>"></div><div><label>Descuento</label><input type="number" step=".01" name="descuento" value="<%= o.descuento||0 %>"></div><button class="btn btn-dark">Guardar</button></form><div class="grand-total"><span>TOTAL</span><strong><%= money(total) %></strong></div></section>
<section class="simple-sheet" id="finalizar-reparacion"><div class="sheet-title"><div><span>CIERRE DE LA REPARACIÓN</span><h3>Finalizar vehículo</h3></div></div><p class="text-muted">Al finalizar, este vehículo saldrá de Lista de reparaciones y pasará a Facturación Quincenal. Seleccione quién realizó el trabajo.</p><form action="/ordenes/<%= o.id %>/finalizar" method="POST" class="finalize-repair-form" onsubmit="return confirm('¿Confirma que esta reparación está finalizada? El vehículo saldrá de la lista de reparaciones activas.')"><div><label>Responsable del trabajo</label><select name="responsable_trabajo" required><option value="">Seleccione...</option><option value="Emerson">Emerson</option><option value="Taller">Taller</option></select></div><button type="submit" class="btn btn-success btn-lg">✓ Reparación finalizada</button></form></section>
<section class="simple-sheet client-advance" id="adelanto-cliente"><div class="sheet-title"><div><span>PARA ENVIAR AL CLIENTE</span><h3>Detalle / adelanto de reparación</h3></div></div><p class="text-muted">El sistema prepara el detalle con lo realizado, repuestos y cobro. Puede modificar el texto antes de descargar la imagen.</p><label class="client-note-label" for="client-note">Nota o detalle adicional</label><textarea id="client-note" class="mechanic-list-input client-note" rows="4" placeholder="Ejemplo: Se realizó revisión general y se recomienda revisar nuevamente en el próximo mantenimiento."></textarea><div id="advance-preview" class="advance-preview"><div class="advance-brand"><strong>CASTELI</strong><span>Detalle de reparación</span></div><div class="advance-vehicle"><strong><%= vehiculo.placa %> · <%= vehiculo.modelo %> <%= vehiculo.anio||'' %></strong><span><%= vehiculo.cliente?.nombre||'' %></span></div><% if(realizados.length){ %><h4>Trabajos realizados</h4><ul><% realizados.forEach(x=>{ %><li><%= x.descripcion %></li><% }) %></ul><% } %><% if(rep.length){ %><h4>Repuestos y materiales</h4><% rep.forEach(x=>{ %><div class="advance-line"><span><%= x.descripcion %> × <%= x.cantidad %></span><strong><%= money(Number(x.cantidad)*Number(x.precio)) %></strong></div><% }) %><div class="advance-line muted"><span>IVA repuestos</span><strong><%= money(iva) %></strong></div><% } %><h4>Servicios de taller</h4><div class="advance-line"><span>Mano de obra / servicios</span><strong><%= money(mano) %></strong></div><% if(otros){ %><div class="advance-line"><span>Otros</span><strong><%= money(otros) %></strong></div><% } %><% if(descuento){ %><div class="advance-line"><span>Descuento</span><strong>- <%= money(descuento) %></strong></div><% } %><div class="advance-total"><span>Total estimado</span><strong><%= money(total) %></strong></div><p class="advance-note-preview" id="advance-note-preview"></p></div><button type="button" id="download-advance" class="btn btn-danger btn-lg">Descargar imagen para el cliente</button></section>
<% } %><section class="simple-sheet"><div class="sheet-title"><div><span>REGISTRO DEL VEHÍCULO</span><h3>Historial de visitas</h3></div><span><%= ordenes.length %> registro(s)</span></div><p class="text-muted">Abra cualquier visita para consultar trabajos, repuestos, cobros y quién realizó la reparación.</p><div class="visit-history-list"><% ordenes.forEach(x=>{ %><a href="/ordenes/<%= x.id %>" class="history-line history-link"><div><strong><%= x.numeroOrden %></strong><span><%= new Date(x.fechaRecepcion).toLocaleDateString('es-CR') %> · <%= Number(x.kilometrajeIngreso).toLocaleString('es-CR') %> km · <%= x.problemaReportado %></span></div><div class="history-link-status"><span><%= x.estado?.nombre||'' %></span><i class="fa fa-chevron-right"></i></div></a><% }) %></div></section><div class="simple-actions"><a href="/ordenes" class="btn btn-outline-secondary">Lista de reparaciones</a><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger">+ Nueva reparación</a></div></div></div>
<% if(o){ %><script>(()=>{const note=document.getElementById('client-note'),notePreview=document.getElementById('advance-note-preview'),btn=document.getElementById('download-advance');if(!note||!btn)return;note.addEventListener('input',()=>{notePreview.textContent=note.value.trim()});const data={placa:<%- JSON.stringify(vehiculo.placa||'') %>,vehiculo:<%- JSON.stringify(`${vehiculo.modelo||''} ${vehiculo.anio||''}`.trim()) %>,cliente:<%- JSON.stringify(vehiculo.cliente?.nombre||'') %>,trabajos:<%- JSON.stringify(realizados.map(x=>x.descripcion)) %>,repuestos:<%- JSON.stringify(rep.map(x=>({descripcion:x.descripcion,cantidad:Number(x.cantidad),total:Number(x.cantidad)*Number(x.precio)}))) %>,iva:<%= Number(iva)||0 %>,mano:<%= mano %>,otros:<%= otros %>,descuento:<%= descuento %>,total:<%= total %>};const col=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});function wrap(ctx,text,x,y,max,line){const words=String(text||'').split(/\s+/);let s='',yy=y;for(const w of words){const test=s?s+' '+w:w;if(ctx.measureText(test).width>max&&s){ctx.fillText(s,x,yy);s=w;yy+=line}else s=test}if(s){ctx.fillText(s,x,yy);yy+=line}return yy}btn.addEventListener('click',()=>{const W=1080,pad=70;let h=390+data.trabajos.length*42+data.repuestos.length*48+(note.value?150:0);h=Math.max(h,760);const c=document.createElement('canvas');c.width=W;c.height=h;const ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,W,h);ctx.fillStyle='#181818';ctx.fillRect(0,0,W,145);ctx.fillStyle='#fff';ctx.font='bold 48px Arial';ctx.fillText('CASTELI',pad,72);ctx.font='24px Arial';ctx.fillStyle='#ccc';ctx.fillText('Detalle de reparación',pad,110);let y=205;ctx.fillStyle='#111';ctx.font='bold 34px Arial';ctx.fillText(data.placa+' · '+data.vehiculo,pad,y);y+=38;ctx.font='22px Arial';ctx.fillStyle='#666';ctx.fillText(data.cliente,pad,y);y+=60;const title=t=>{ctx.fillStyle='#111';ctx.font='bold 25px Arial';ctx.fillText(t,pad,y);y+=38};const line=(a,b)=>{ctx.font='21px Arial';ctx.fillStyle='#333';ctx.fillText(a,pad,y);ctx.font='bold 21px Arial';ctx.textAlign='right';ctx.fillText(b,W-pad,y);ctx.textAlign='left';y+=38};if(data.trabajos.length){title('Trabajos realizados');ctx.font='21px Arial';ctx.fillStyle='#333';data.trabajos.forEach(t=>{ctx.fillText('✓',pad,y);y=wrap(ctx,t,pad+32,y,W-pad*2-32,30)+8});y+=15}if(data.repuestos.length){title('Repuestos y materiales');data.repuestos.forEach(r=>line(r.descripcion+' × '+r.cantidad,col(r.total)));line('IVA repuestos',col(data.iva));y+=15}title('Servicios de taller');line('Mano de obra / servicios',col(data.mano));if(data.otros)line('Otros',col(data.otros));if(data.descuento)line('Descuento','- '+col(data.descuento));y+=10;ctx.fillStyle='#181818';ctx.fillRect(pad,y,W-pad*2,78);ctx.fillStyle='#fff';ctx.font='bold 25px Arial';ctx.fillText('TOTAL ESTIMADO',pad+25,y+49);ctx.textAlign='right';ctx.font='bold 32px Arial';ctx.fillText(col(data.total),W-pad-25,y+51);ctx.textAlign='left';y+=120;if(note.value.trim()){ctx.fillStyle='#555';ctx.font='20px Arial';y=wrap(ctx,note.value.trim(),pad,y,W-pad*2,30)}const a=document.createElement('a');a.download='Casteli-'+data.placa+'-detalle.png';a.href=c.toDataURL('image/png');a.click()})})();</script><% } %>