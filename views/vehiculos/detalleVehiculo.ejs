<% const o=ordenActual;const rep=o?.repuestos||[];const trabajos=o?.trabajos||[];const detectados=trabajos.filter(x=>x.estado==='detectado');const realizados=trabajos.filter(x=>x.estado!=='detectado');const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0);const iva=subtotal*.13;const totalRepuestos=subtotal+iva;const total=o?Math.max(0,totalRepuestos+Number(o.manoObra||0)+Number(o.otros||0)-Number(o.descuento||0)):0;const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});const yaEnRepuestos=d=>rep.some(r=>String(r.descripcion).trim().toLowerCase()===String(d).trim().toLowerCase()); %>
<div class="content"><div class="container-fluid casteli-simple-page"><section class="vehicle-sheet-hero"><div><span>FICHA DEL VEHÍCULO</span><h1><%= vehiculo.placa %></h1><p><%= vehiculo.modelo %> <%= vehiculo.anio||'' %></p></div><div><small>Propietario</small><strong><%= vehiculo.cliente?.nombre||'Sin propietario' %></strong><span><%= vehiculo.cliente?.telefono||'' %></span></div></section>
<section class="simple-sheet"><div class="sheet-title"><h3>Mantenimiento</h3><span>Información permanente</span></div><form action="/vehiculos/<%= vehiculo.id %>/mantenimiento#reparacion-actual" method="POST" class="maintenance-grid"><div><label>Kilometraje actual</label><input type="number" name="kilometraje_actual" value="<%= vehiculo.kilometrajeActual||0 %>"></div><div><label>Próximo aceite (km)</label><input type="number" name="proximo_aceite_km" value="<%= vehiculo.proximoAceiteKm||'' %>"></div><div><label>Próximo aceite (fecha)</label><input type="date" name="proximo_aceite_fecha" value="<%= vehiculo.proximoAceiteFecha||'' %>"></div><div><label>Próximo líquido de frenos</label><input type="date" name="proximo_frenos_fecha" value="<%= vehiculo.proximoFrenosFecha||'' %>"></div><button class="btn btn-dark">Guardar</button></form></section>
<% if(!o){ %><section class="simple-sheet text-center"><h3>No hay reparación actual</h3><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger btn-lg">+ Nueva reparación</a></section><% }else{ %><section class="simple-sheet" id="reparacion-actual"><div class="sheet-title"><div><span>REPARACIÓN ACTUAL</span><h3><%= o.numeroOrden %></h3></div><strong><%= o.estado?.nombre||'' %></strong></div><div class="repair-summary"><div><span>Ingreso</span><strong><%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></strong></div><div><span>Kilometraje</span><strong><%= Number(o.kilometrajeIngreso).toLocaleString('es-CR') %> km</strong></div><div class="wide"><span>Motivo de ingreso</span><strong><%= o.problemaReportado %></strong><% if(o.observaciones){ %><p><%= o.observaciones %></p><% } %></div></div></section>
<section class="simple-sheet workshop-list" id="lista-reparacion"><div class="sheet-title"><div><span>AYUDANTES DE TALLER</span><h3>Lista de reparación</h3></div><span><%= detectados.length %> pendiente(s)</span></div><p class="text-muted">Toque una tarea cuando esté terminada. Se moverá automáticamente a Trabajo realizado.</p><div class="mechanic-checklist"><% detectados.forEach(x=>{ %><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form"><input type="hidden" name="realizado" value="1"><button type="submit" class="mechanic-item mechanic-item-button"><span class="mechanic-checkbox"></span><strong><%= x.descripcion %></strong><small>Marcar realizado</small></button></form><% }) %></div><form action="/ordenes/<%= o.id %>/trabajos" method="POST"><input type="hidden" name="tipo" value="detectado"><textarea name="descripcion" rows="6" class="mechanic-list-input" placeholder="Una reparación por línea..." required></textarea><button class="btn btn-danger btn-lg mt-2">+ Agregar a la lista</button></form></section>
<section class="simple-sheet" id="trabajo-realizado"><div class="sheet-title"><h3>Trabajo realizado</h3><span><%= realizados.length %> realizado(s)</span></div><div class="mechanic-checklist completed"><% realizados.forEach(x=>{ %><form action="/ordenes/trabajos/<%= x.id %>/estado" method="POST" class="mechanic-check-form"><input type="hidden" name="realizado" value="0"><button class="mechanic-item mechanic-item-button completed" type="submit"><span class="mechanic-checkbox checked">✓</span><strong><%= x.descripcion %></strong><small>Deshacer</small></button></form><% }) %></div><details class="manual-work"><summary>Agregar un trabajo que no estaba en la lista</summary><form action="/ordenes/<%= o.id %>/trabajos" method="POST" class="quick-row"><input type="hidden" name="tipo" value="realizado"><input name="descripcion" placeholder="Trabajo adicional realizado" required><button class="btn btn-dark">+ Agregar</button></form></details></section>
<section class="simple-sheet" id="repuestos"><div class="sheet-title"><div><span>COBRO</span><h3>Repuestos y materiales</h3></div><span><%= rep.length %> agregado(s)</span></div><p class="text-muted">Seleccione de la lista de reparación lo que corresponda a un repuesto o material. Luego indique cantidad y precio.</p><div class="parts-from-work"><% trabajos.forEach(x=>{const usado=yaEnRepuestos(x.descripcion);%><form action="/ordenes/trabajos/<%= x.id %>/repuesto" method="POST"><button class="part-pick <%= usado?'selected':'' %>" type="submit" <%= usado?'disabled':'' %>><span class="mechanic-checkbox <%= usado?'checked':'' %>"><%= usado?'✓':'+' %></span><span><strong><%= x.descripcion %></strong><small><%= x.estado==='realizado'?'Trabajo realizado':'Pendiente' %></small></span><b><%= usado?'Agregado':'Usar como repuesto' %></b></button></form><% }) %></div>
<% if(rep.length){ %><div class="parts-edit-list"><div class="parts-edit-head"><span>Descripción</span><span>Cantidad</span><span>Precio unitario</span><span>Total</span><span></span></div><% rep.forEach(x=>{const t=Number(x.cantidad)*Number(x.precio);%><form action="/ordenes/repuestos/<%= x.id %>/editar" method="POST" class="parts-edit-row"><input name="descripcion" value="<%= x.descripcion %>" required><input type="number" min="0.01" step="0.01" name="cantidad" value="<%= x.cantidad %>" required><input type="number" min="0" step="0.01" name="precio" value="<%= x.precio %>" required><strong><%= money(t) %></strong><button class="btn btn-dark btn-sm">Guardar</button></form><% }) %></div><% }else{ %><p class="empty-inline">Aún no hay repuestos agregados.</p><% } %>
<details class="manual-work"><summary>Agregar otro repuesto o material manualmente</summary><form action="/ordenes/<%= o.id %>/repuestos" method="POST" class="parts-row"><input name="descripcion" placeholder="Repuesto o material" required><input type="number" min="0.01" step=".01" name="cantidad" value="1" required><input type="number" min="0" step=".01" name="precio" placeholder="Precio venta" required><button class="btn btn-dark">+ Agregar</button></form></details><div class="cost-box"><div><span>Subtotal</span><strong><%= money(subtotal) %></strong></div><div><span>IVA 13%</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(totalRepuestos) %></strong></div></div></section>
<section class="simple-sheet" id="cuenta-taller"><h3>Cuenta del taller</h3><form action="/ordenes/<%= o.id %>/totales" method="POST" class="totals-grid"><div><label>Mano de obra</label><input type="number" step=".01" name="mano_obra" value="<%= o.manoObra||0 %>"></div><div><label>Otros</label><input type="number" step=".01" name="otros" value="<%= o.otros||0 %>"></div><div><label>Descuento</label><input type="number" step=".01" name="descuento" value="<%= o.descuento||0 %>"></div><button class="btn btn-dark">Guardar</button></form><div class="grand-total"><span>TOTAL</span><strong><%= money(total) %></strong></div></section><% } %><section class="simple-sheet"><div class="sheet-title"><h3>Historial de visitas</h3><span><%= ordenes.length %> registro(s)</span></div><% ordenes.forEach(x=>{ %><div class="history-line"><div><strong><%= x.numeroOrden %></strong><span><%= new Date(x.fechaRecepcion).toLocaleDateString('es-CR') %> · <%= Number(x.kilometrajeIngreso).toLocaleString('es-CR') %> km · <%= x.problemaReportado %></span></div><span><%= x.estado?.nombre||'' %></span></div><% }) %></section><div class="simple-actions"><a href="/ordenes" class="btn btn-outline-secondary">Lista de reparaciones</a><a href="/ordenes/nueva/<%= vehiculo.id %>" class="btn btn-danger">+ Nueva reparación</a></div></div></div>