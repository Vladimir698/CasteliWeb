<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ingresar · Casteli Automotriz</title><link href="/css/bootstrap.min.css" rel="stylesheet"><link href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" rel="stylesheet"><link href="/css/casteli-simple.css" rel="stylesheet"></head><body class="casteli-login-body"><main class="casteli-login-card"><div class="casteli-login-logo"><img src="/images/logo-casteli.png" alt="Casteli Automotriz"></div><div class="casteli-login-copy"><span>ACCESO AL TALLER</span><h1>Iniciar sesión</h1><p>Ingrese con su usuario de Casteli.</p></div><% if(error){ %><div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> <%= error %></div><% } %><form method="POST" action="/login" class="casteli-login-form"><label for="usuario">Usuario</label><div class="login-field"><i class="fa fa-user"></i><input id="usuario" name="usuario" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus></div><label for="passwordInput">Contraseña</label><div class="login-field"><i class="fa fa-lock"></i><input type="password" id="passwordInput" name="password" autocomplete="current-password" required><button type="button" id="togglePassword" aria-label="Mostrar contraseña"><i class="fa fa-eye"></i></button></div><button class="btn btn-danger btn-block casteli-login-submit" type="submit"><i class="fa fa-sign-in"></i> Entrar a Casteli</button></form><p class="casteli-login-security"><i class="fa fa-shield"></i> Acceso exclusivo para personal autorizado.</p></main><script>const p=document.getElementById('passwordInput'),b=document.getElementById('togglePassword');b.addEventListener('click',()=>{const show=p.type==='password';p.type=show?'text':'password';b.innerHTML=show?'<i class="fa fa-eye-slash"></i>':'<i class="fa fa-eye"></i>';});</script></body></html>