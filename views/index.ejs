<% const rol = usuario ? usuario.rol : ''; %>

<div class="content casteli-dashboard">
  <div class="casteli-dashboard-container">

    <section class="casteli-start-panel">

  <div class="casteli-start-content">

    <span class="casteli-start-label">
      INICIO RÁPIDO
    </span>

    <h1>
      Comience registrando al cliente
    </h1>

    <p>
      Registre un cliente nuevo o consulte uno existente.
      Desde su perfil podrá agregar vehículos y crear órdenes de trabajo.
    </p>

    <div class="casteli-start-actions">

      <a href="/clientes/nuevo" class="casteli-primary-action">
        <i class="fa fa-user-plus"></i>
        Registrar cliente
      </a>

      <a href="/clientes" class="casteli-secondary-action">
        <i class="fa fa-search"></i>
        Buscar cliente
      </a>

      <a href="/ordenes" class="casteli-text-action">
        Ver órdenes activas
        <i class="fa fa-arrow-right"></i>
      </a>

    </div>

  </div>

  <div class="casteli-start-steps">

    <div class="casteli-step">
      <span>01</span>
      <div>
        <strong>Registrar cliente</strong>
        <small>Datos personales y contacto.</small>
      </div>
    </div>

    <div class="casteli-step">
      <span>02</span>
      <div>
        <strong>Agregar vehículo</strong>
        <small>Placa, marca, modelo y kilometraje.</small>
      </div>
    </div>

    <div class="casteli-step">
      <span>03</span>
      <div>
        <strong>Crear orden</strong>
        <small>Diagnóstico y trabajos del taller.</small>
      </div>
    </div>

  </div>

</section>

    <section class="casteli-section-header">
      <div>
        <span>Módulos</span>
        <h2>Administración del taller</h2>
      </div>

      <p>
        Seleccione una sección para comenzar.
      </p>
    </section>

    <div class="casteli-module-grid">

      <% if (
        rol === 'Administrador' ||
        rol === 'Mecanico_Administrativo'
      ) { %>

        <a
          href="/clientes"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="80"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-users"></i>
            </div>

            <span class="casteli-module-number">01</span>
          </div>

          <div class="casteli-module-body">
            <h3>Clientes</h3>
            <p>
              Registre clientes y consulte sus vehículos,
              órdenes e historial.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/vehiculos"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="130"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-car"></i>
            </div>

            <span class="casteli-module-number">02</span>
          </div>

          <div class="casteli-module-body">
            <h3>Vehículos</h3>
            <p>
              Consulte placas, kilometraje, características
              e historial mecánico.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

      <% } %>

      <a
        href="/ordenes"
        class="casteli-module-card casteli-module-featured"
        data-aos="fade-up"
        data-aos-delay="180"
      >
        <div class="casteli-module-top">
          <div class="casteli-module-icon">
            <i class="fa fa-wrench"></i>
          </div>

          <span class="casteli-module-number">03</span>
        </div>

        <div class="casteli-module-body">
          <h3>Órdenes de trabajo</h3>
          <p>
            Administre diagnósticos, reparaciones,
            avances y observaciones del taller.
          </p>
        </div>

        <div class="casteli-module-footer">
          Abrir módulo
          <i class="fa fa-arrow-right"></i>
        </div>
      </a>

      <% if (
        rol === 'Administrador' ||
        rol === 'Mecanico_Administrativo'
      ) { %>

        <a
          href="/proveedores"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="230"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-truck"></i>
            </div>

            <span class="casteli-module-number">04</span>
          </div>

          <div class="casteli-module-body">
            <h3>Proveedores</h3>
            <p>
              Gestione proveedores de repuestos,
              materiales y servicios.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/inventario"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="280"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-cubes"></i>
            </div>

            <span class="casteli-module-number">05</span>
          </div>

          <div class="casteli-module-body">
            <h3>Inventario</h3>
            <p>
              Controle existencias, costos,
              precios y movimientos de repuestos.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/compras"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="330"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-shopping-cart"></i>
            </div>

            <span class="casteli-module-number">06</span>
          </div>

          <div class="casteli-module-body">
            <h3>Compras</h3>
            <p>
              Registre facturas y compras realizadas
              a los proveedores.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/prefacturas"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="380"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-file-text-o"></i>
            </div>

            <span class="casteli-module-number">07</span>
          </div>

          <div class="casteli-module-body">
            <h3>Prefacturas</h3>
            <p>
              Prepare repuestos, mano de obra,
              descuentos e impuestos.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

      <% } %>

      <% if (rol === 'Administrador') { %>

        <a
          href="/usuarios"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="430"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-user"></i>
            </div>

            <span class="casteli-module-number">08</span>
          </div>

          <div class="casteli-module-body">
            <h3>Usuarios</h3>
            <p>
              Administre usuarios, roles
              y niveles de acceso.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/reportes"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="480"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-bar-chart"></i>
            </div>

            <span class="casteli-module-number">09</span>
          </div>

          <div class="casteli-module-body">
            <h3>Reportes</h3>
            <p>
              Consulte ingresos, compras,
              productividad e indicadores.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

        <a
          href="/configuracion"
          class="casteli-module-card"
          data-aos="fade-up"
          data-aos-delay="530"
        >
          <div class="casteli-module-top">
            <div class="casteli-module-icon">
              <i class="fa fa-cog"></i>
            </div>

            <span class="casteli-module-number">10</span>
          </div>

          <div class="casteli-module-body">
            <h3>Configuración</h3>
            <p>
              Configure estados, parámetros
              y datos generales del taller.
            </p>
          </div>

          <div class="casteli-module-footer">
            Abrir módulo
            <i class="fa fa-arrow-right"></i>
          </div>
        </a>

      <% } %>

    </div>
  </div>
</div>