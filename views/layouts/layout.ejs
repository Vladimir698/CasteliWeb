<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no"><title>Casteli Automotriz</title><link rel="icon" type="image/png" href="/images/logo-casteli.png"><link href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" rel="stylesheet"><link href="/css/bootstrap.min.css" rel="stylesheet"><link href="/css/paper-dashboard.css" rel="stylesheet"><link href="/css/brand-overrides.css" rel="stylesheet"><link href="/css/custom.css" rel="stylesheet"><link href="/css/casteli-simple.css" rel="stylesheet"><%- style || '' %></head><body><% const esVistaPrincipal=rutaActual==='/home'; %><div class="wrapper <%= esVistaPrincipal?'home-without-sidebar':'' %>"><% if(!esVistaPrincipal){ %><%- include('../partials/sidebar') %><% } %><div class="main-panel <%= esVistaPrincipal?'main-panel-full':'' %>"><nav class="navbar navbar-expand-lg navbar-absolute fixed-top navbar-transparent"><div class="container-fluid"><div class="navbar-wrapper"><a href="/home" class="mobile-top-brand"><img src="/images/logo-casteli.png" alt="Casteli"></a><div class="navbar-toggle"><button type="button" class="navbar-toggler"><span class="navbar-toggler-bar bar1"></span><span class="navbar-toggler-bar bar2"></span><span class="navbar-toggler-bar bar3"></span></button></div></div><div class="ml-auto"><% if(usuario){ %><a href="/perfil" class="user-top-button"><span class="user-top-avatar"><%= usuario.nombre?usuario.nombre.charAt(0).toUpperCase():'A' %></span><span><strong><%= usuario.nombre||'Administrador' %></strong><br><small><%= usuario.rol||'Administrador' %></small></span></a><form method="POST" action="/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="logout-top-button" title="Cerrar sesión" style="border:0;background:transparent"><i class="fa fa-sign-out"></i></button></form><% } %></div></div></nav><%- body %><nav class="mobile-bottom-nav" aria-label="Navegación principal"><a href="/home" class="<%= rutaActual==='/home'?'active':'' %>"><i class="fa fa-home"></i><span>Inicio</span></a><a href="/ordenes" class="<%= rutaActual?.startsWith('/ordenes')?'active':'' %>"><i class="fa fa-wrench"></i><span>Reparaciones</span></a><a href="/vehiculos/buscar" class="<%= rutaActual?.startsWith('/vehiculos/buscar')?'active':'' %>"><i class="fa fa-search"></i><span>Buscar</span></a><a href="/vehiculos/nuevo" class="<%= rutaActual==='/vehiculos/nuevo'?'active':'' %>"><i class="fa fa-plus-circle"></i><span>Registrar</span></a><% if(esAdmin){ %><a href="/facturacion-quincenal" class="<%= rutaActual?.startsWith('/facturacion-quincenal')?'active':'' %>"><i class="fa fa-calendar-check-o"></i><span>Quincena</span></a><% } %></nav><footer class="footer"><div class="container-fluid"><div class="credits ml-auto">© <%= new Date().getFullYear() %> Casteli Automotriz</div></div></footer></div></div><script>window.CASTELI_CSRF=<%- JSON.stringify(csrfToken) %>;document.querySelectorAll('form').forEach(function(form){if((form.method||'get').toLowerCase()!=='post'||form.querySelector('input[name="_csrf"]'))return;var input=document.createElement('input');input.type='hidden';input.name='_csrf';input.value=window.CASTELI_CSRF;form.appendChild(input);});</script><script src="/js/core/jquery.min.js"></script><script src="/js/core/popper.min.js"></script><script src="/js/core/bootstrap.min.js"></script><script src="/js/casteli-client-summary.js"></script><script src="/js/casteli-ux.js"></script><%- script || '' %><script>$(document).ready(function(){$('.navbar .navbar-toggler').on('click',function(){$('html').toggleClass('nav-open')})});</script></body></html>
