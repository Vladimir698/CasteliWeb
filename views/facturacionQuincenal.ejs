<div class="content"><div class="container-fluid casteli-simple-page billing-page">
<section class="simple-sheet billing-summary-sheet">
 <div class="sheet-title"><div><span>CIERRES DEL TALLER</span><h2>Facturación Quincenal</h2><p class="text-muted mb-0">Resumen automático de los vehículos finalizados durante el período.</p></div></div>
 <form method="GET" action="/facturacion-quincenal" class="billing-filter"><div><label>Desde</label><input type="date" name="desde" value="<%= desde %>"></div><div><label>Hasta</label><input type="date" name="hasta" value="<%= hasta %>"></div><button class="btn btn-dark"><i class="fa fa-filter"></i> Ver período</button></form>
 <div class="billing-period-stats"><div><span class="billing-stat-icon"><i class="fa fa-car"></i></span><p><small>Vehículos finalizados</small><strong><%= filas.length %></strong></p></div><div><span class="billing-stat-icon"><i class="fa fa-calendar"></i></span><p><small>Período consultado</small><strong><%= new Date(desde+'T00:00:00').toLocaleDateString('es-CR') %> — <%= new Date(hasta+'T00:00:00').toLocaleDateString('es-CR') %></strong></p></div></div>
</section>
<% grupos.forEach(g=>{ %><section class="simple-sheet billing-group-card">
 <div class="sheet-title billing-group-head"><div><span>RESPONSABLE</span><h3><%= g.responsable %></h3><small><%= g.filas.length %> vehículo<%= g.filas.length===1?'':'s' %> finalizado<%= g.filas.length===1?'':'s' %></small></div><div class="billing-group-total"><small>Servicios del período</small><strong>₡<%= g.servicios.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div></div>
 <div class="billing-desktop-table"><div class="table-responsive"><table class="table billing-table"><thead><tr><th>Fecha</th><th>Vehículo</th><% if(g.responsable==='Taller'){ %><th>Realizado por</th><% } %><th>Cliente</th><th>Servicio</th><th>Total detalle</th></tr></thead><tbody><% g.filas.forEach(f=>{const o=f.orden;%><tr><td><%= new Date(o.fechaFin).toLocaleDateString('es-CR') %></td><td><strong><%= o.vehiculo?.placa||'' %></strong><br><small><%= o.vehiculo?.modelo||'' %></small></td><% if(g.responsable==='Taller'){ %><td><% if(f.usuarioTaller){ %><span class="billing-worker"><i class="fa fa-user"></i> <%= f.usuarioTaller %></span><% }else{ %><span class="text-muted">—</span><% } %></td><% } %><td><%= o.vehiculo?.cliente?.nombre||'' %></td><td><strong>₡<%= f.servicio.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></td><td>₡<%= f.total.toLocaleString('es-CR',{maximumFractionDigits:2}) %></td></tr><% }) %></tbody></table></div></div>
 <div class="billing-mobile-list"><% g.filas.forEach(f=>{const o=f.orden;%><article class="billing-mobile-card"><div class="billing-mobile-top"><div><strong><%= o.vehiculo?.placa||'Sin placa' %></strong><span><%= o.vehiculo?.modelo||'' %></span></div><time><%= new Date(o.fechaFin).toLocaleDateString('es-CR') %></time></div><div class="billing-mobile-client"><i class="fa fa-user-o"></i><span><%= o.vehiculo?.cliente?.nombre||'Sin cliente' %></span><% if(g.responsable==='Taller' && f.usuarioTaller){ %><b><i class="fa fa-wrench"></i> <%= f.usuarioTaller %></b><% } %></div><div class="billing-mobile-money"><div><small>Servicio</small><strong>₡<%= f.servicio.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div><div><small>Total detalle</small><strong>₡<%= f.total.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div></div></article><% }) %></div>
 <div class="billing-footer"><span>Total servicios <%= g.responsable %></span><strong>₡<%= g.servicios.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div>
</section><% }) %>
<% if(!filas.length){ %><section class="simple-sheet repair-empty-state"><span class="action-icon"><i class="fa fa-check"></i></span><h4>Sin cierres en este período</h4><p>No hay reparaciones finalizadas entre las fechas seleccionadas.</p></section><% } %>
<section class="simple-sheet billing-history"><div class="sheet-title"><div><span>HISTORIAL</span><h3>Facturaciones quincenales</h3><p class="text-muted mb-0">Acceso rápido a períodos anteriores.</p></div></div><div class="billing-history-grid"><% historial.forEach(h=>{ %><a href="/facturacion-quincenal?desde=<%= h.desde %>&hasta=<%= h.hasta %>" class="<%= desde===h.desde && hasta===h.hasta ? 'active':'' %>"><span><i class="fa fa-calendar-o"></i></span><div><strong><%= h.label %></strong><small>Ver facturación</small></div><i class="fa fa-chevron-right"></i></a><% }) %></div></section>
</div></div>