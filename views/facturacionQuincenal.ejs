<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>CIERRES DEL TALLER</span><h2>Facturación Quincenal</h2></div></div><form method="GET" action="/facturacion-quincenal" class="billing-filter"><div><label>Desde</label><input type="date" name="desde" value="<%= desde %>"></div><div><label>Hasta</label><input type="date" name="hasta" value="<%= hasta %>"></div><button class="btn btn-dark">Ver período</button></form><p class="text-muted">Solo aparecen reparaciones finalizadas. Se agrupan por Emerson, Taller u otro responsable registrado al cerrar.</p></section>
<% grupos.forEach(g=>{ %><section class="simple-sheet"><div class="sheet-title"><div><span>RESPONSABLE</span><h3><%= g.responsable %></h3></div><div class="billing-group-total"><small>Servicios del período</small><strong>₡<%= g.servicios.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div></div><div class="table-responsive"><table class="table billing-table"><thead><tr><th>Fecha</th><th>Vehículo</th><th>Cliente</th><th>Orden</th><th>Servicio taller</th><th>Total detalle</th><th>GTI</th></tr></thead><tbody><% g.filas.forEach(f=>{const o=f.orden;%><tr><td><%= new Date(o.fechaFin).toLocaleDateString('es-CR') %></td><td><strong><%= o.vehiculo?.placa||'' %></strong><br><small><%= o.vehiculo?.modelo||'' %></small></td><td><%= o.vehiculo?.cliente?.nombre||'' %></td><td><%= o.numeroOrden %></td><td><strong>₡<%= f.servicio.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></td><td>₡<%= f.total.toLocaleString('es-CR',{maximumFractionDigits:2}) %></td><td><% if(o.gtiEstado==='enviada'){ %><span class="badge badge-success">Enviada</span><% if(o.gtiReferencia){ %><br><small><%= o.gtiReferencia %></small><% } %><% }else if(gtiConfigurado){ %><form action="/facturacion-quincenal/<%= o.id %>/gti" method="POST" onsubmit="return confirm('¿Enviar esta orden a GTI Facturación?')"><button class="btn btn-sm btn-outline-dark">Enviar a GTI</button></form><% }else{ %><small class="text-muted">GTI por configurar</small><% } %></td></tr><% }) %></tbody></table></div><div class="billing-footer"><span>Total servicios <%= g.responsable %></span><strong>₡<%= g.servicios.toLocaleString('es-CR',{maximumFractionDigits:2}) %></strong></div></section><% }) %>
<% if(!filas.length){ %><section class="simple-sheet text-center py-5"><h4>No hay reparaciones finalizadas en esta quincena</h4></section><% } %></div></div>