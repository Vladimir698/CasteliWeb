<% const rol = usuario ? usuario.rol : ''; %>

<div class="sidebar" data-color="black" data-active-color="danger">

  <div class="logo casteli-sidebar-logo">
    <a href="/home" class="simple-text logo-normal">
      <img
        src="/images/logo-casteli.png"
        alt="Casteli Automotriz"
        class="casteli-logo-img"
      >
    </a>
  </div>

  <div class="sidebar-wrapper">
    <ul class="nav">

      <li>
        <a href="/home">
          <i class="nc-icon nc-bank"></i>
          <p>Inicio</p>
        </a>
      </li>

      <% if (
        rol === 'Administrador' ||
        rol === 'Mecanico_Administrativo'
      ) { %>

        <li>
          <a href="/clientes">
            <i class="nc-icon nc-single-02"></i>
            <p>Clientes</p>
          </a>
        </li>

        <li>
          <a href="/vehiculos">
            <i class="nc-icon nc-bus-front-12"></i>
            <p>Vehículos</p>
          </a>
        </li>

      <% } %>

      <li>
        <a href="/ordenes">
          <i class="nc-icon nc-settings"></i>
          <p>Órdenes de trabajo</p>
        </a>
      </li>

      <% if (
        rol === 'Administrador' ||
        rol === 'Mecanico_Administrativo'
      ) { %>

        <li>
          <a href="/proveedores">
            <i class="nc-icon nc-delivery-fast"></i>
            <p>Proveedores</p>
          </a>
        </li>

        <li>
          <a href="/inventario">
            <i class="nc-icon nc-box-2"></i>
            <p>Inventario</p>
          </a>
        </li>

        <li>
          <a href="/compras">
            <i class="nc-icon nc-cart-simple"></i>
            <p>Compras</p>
          </a>
        </li>

        <li>
          <a href="/prefacturas">
            <i class="nc-icon nc-paper"></i>
            <p>Prefacturas</p>
          </a>
        </li>

      <% } %>

      <% if (rol === 'Administrador') { %>

        <li>
          <a href="/usuarios">
            <i class="nc-icon nc-circle-10"></i>
            <p>Usuarios</p>
          </a>
        </li>

        <li>
          <a href="/reportes">
            <i class="nc-icon nc-chart-bar-32"></i>
            <p>Reportes</p>
          </a>
        </li>

        <li>
          <a href="/configuracion">
            <i class="nc-icon nc-settings-gear-65"></i>
            <p>Configuración</p>
          </a>
        </li>

      <% } %>

    </ul>
  </div>
</div>