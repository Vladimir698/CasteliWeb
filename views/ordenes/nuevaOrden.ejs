<div class="content">
  <div class="container-fluid">

    <section class="responsive-form-card">

      <header class="responsive-form-header">
        <div>
          <span class="form-eyebrow">NUEVA ORDEN DE TRABAJO</span>
          <h2>Ingreso del vehículo al taller</h2>

          <p>
            Registre el kilometraje, condición inicial y problema
            reportado por el cliente.
          </p>
        </div>

        <div class="d-none d-md-flex align-items-center">
          <i
            class="fa fa-wrench"
            aria-hidden="true"
            style="font-size: 40px; color: #d71920;"
          ></i>
        </div>
      </header>

      <div class="vehicle-summary-card mb-4">
        <div class="vehicle-summary-icon">
          <i class="fa fa-car" aria-hidden="true"></i>
        </div>

        <div class="vehicle-summary-content">
          <span>Vehículo</span>

          <strong>
            <%= vehiculo.placa %> ·
            <%= vehiculo.marca %>
            <%= vehiculo.modelo %>
          </strong>

          <small>
            Cliente:
            <%= vehiculo.cliente?.nombre || 'Sin cliente asignado' %>
          </small>
        </div>

        <a
          href="/vehiculos/<%= vehiculo.id %>"
          class="btn btn-sm btn-outline-secondary"
        >
          Ver vehículo
        </a>
      </div>

      <% if (errores && errores.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <strong>No fue posible crear la orden:</strong>

          <ul class="mb-0 mt-2">
            <% errores.forEach(error => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form
        action="/ordenes/vehiculo/<%= vehiculo.id %>"
        method="POST"
        autocomplete="off"
      >
        <div class="responsive-form-grid">

          <div class="form-group">
            <label for="kilometraje_ingreso">
              Kilometraje de ingreso
              <span class="text-danger">*</span>
            </label>

            <input
              id="kilometraje_ingreso"
              name="kilometraje_ingreso"
              type="number"
              class="form-control"
              min="0"
              step="1"
              inputmode="numeric"
              value="<%=
                orden?.kilometraje_ingreso ??
                orden?.kilometrajeIngreso ??
                vehiculo?.kilometrajeActual ??
                vehiculo?.kilometraje_actual ??
                ''
              %>"
              placeholder="Ejemplo: 125000"
              required
              autofocus
            >

            <small class="form-text text-muted">
              Kilometraje registrado anteriormente:
              <%=
                vehiculo?.kilometrajeActual ??
                vehiculo?.kilometraje_actual ??
                0
              %> km
            </small>
          </div>

          <div class="form-group">
            <label for="nivel_combustible">
              Nivel de combustible
            </label>

            <select
              id="nivel_combustible"
              name="nivel_combustible"
              class="form-control"
            >
              <option value="">Seleccione</option>

              <% [
                'Vacío',
                '1/4',
                '1/2',
                '3/4',
                'Lleno'
              ].forEach(opcion => { %>
                <option
                  value="<%= opcion %>"
                  <%=
                    (
                      orden?.nivel_combustible ||
                      orden?.nivelCombustible
                    ) === opcion
                      ? 'selected'
                      : ''
                  %>
                >
                  <%= opcion %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="prioridad">
              Prioridad
            </label>

            <select
              id="prioridad"
              name="prioridad"
              class="form-control"
            >
              <% [
                'Baja',
                'Normal',
                'Alta',
                'Urgente'
              ].forEach(opcion => { %>
                <option
                  value="<%= opcion %>"
                  <%=
                    (orden?.prioridad || 'Normal') === opcion
                      ? 'selected'
                      : ''
                  %>
                >
                  <%= opcion %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="fecha_recepcion_visual">
              Fecha de recepción
            </label>

            <input
              id="fecha_recepcion_visual"
              type="text"
              class="form-control"
              value="<%= new Date().toLocaleString('es-CR') %>"
              readonly
            >
          </div>

          <div class="form-group form-group-full">
            <label for="problema_reportado">
              Problema reportado por el cliente
              <span class="text-danger">*</span>
            </label>

            <textarea
              id="problema_reportado"
              name="problema_reportado"
              class="form-control"
              rows="5"
              placeholder="Describa con las palabras del cliente el problema o servicio solicitado"
              required
            ><%=
              orden?.problema_reportado ||
              orden?.problemaReportado ||
              ''
            %></textarea>
          </div>

          <div class="form-group form-group-full">
            <label for="observaciones">
              Observaciones de recepción
            </label>

            <textarea
              id="observaciones"
              name="observaciones"
              class="form-control"
              rows="4"
              placeholder="Golpes visibles, accesorios entregados, testigos encendidos u otras condiciones"
            ><%= orden?.observaciones || '' %></textarea>
          </div>

        </div>

        <div class="responsive-form-actions">
          <a
            href="/vehiculos/<%= vehiculo.id %>"
            class="btn btn-outline-secondary"
          >
            <i class="fa fa-times" aria-hidden="true"></i>
            Cancelar
          </a>

          <button
            type="submit"
            class="btn btn-danger"
          >
            <i class="fa fa-wrench" aria-hidden="true"></i>
            Crear orden de trabajo
          </button>
        </div>
      </form>

    </section>

  </div>
</div>