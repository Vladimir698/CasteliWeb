<%
const o=ordenActual;
const rep=o?.repuestos||[];
const trabajos=o?.trabajos||[];
const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0);
const iva=subtotal*.13;
const mano=Number(o?.manoObra||0),otros=Number(o?.otros||0),descuento=Number(o?.descuento||0);
const ivaTaller=(mano+otros)*.13;
const total=Math.max(0,subtotal+iva+mano+otros+ivaTaller-descuento);
const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});
const yaEnRepuestos=d=>rep.some(r=>String(r.descripcion).trim().toLowerCase()===String(d).trim().toLowerCase());
%>
<div class="content"><div class="container-fluid casteli-simple-page quotation-page">
<section class="vehicle-sheet-hero"><div><span>COTIZACIÓN EN PREPARACIÓN</span><h1><%= vehiculo.placa %></h1><p><%= vehiculo.modelo %> <%= vehiculo.anio||'' %></p></div><div><small>Propietario</small><strong><%= vehiculo.cliente?.nombre||'Sin propietario' %></strong><span><%= vehiculo.cliente?.telefono||'' %></span></div></section>

<% if(!esAdmin){ %>
<section class="simple-sheet quotation-locked"><div class="action-icon"><i class="fa fa-file-text-o"></i></div><h3>Cotización en preparación</h3><p>Administración está preparando la cotización de este vehículo. Cuando sea aprobada y convertida en reparación, aparecerá aquí la lista normal de trabajo.</p><a href="/ordenes" class="btn btn-outline-secondary">Volver a reparaciones</a></section>
<% }else{ %>
<section class="simple-sheet quotation-header" id="cotizacion"><div class="current-order-head"><div><span class="form-eyebrow">COTIZACIÓN</span><h3><%= o.numeroOrden %></h3><p>Prepare el detalle y los precios antes de enviarlo al cliente.</p></div><span class="quotation-pill">BORRADOR</span></div></section>

<section class="simple-sheet workshop-list" id="lista-reparacion"><div class="sheet-title"><div><span>TRABAJOS A COTIZAR</span><h3>Lista de reparación propuesta</h3></div><span><%= trabajos.length %> elemento(s)</span></div>
<p class="text-muted">Pegue todos los trabajos o repuestos, uno por línea. Después seleccione los que deben aparecer en el cobro y asígneles cantidad y precio.</p>
<div class="mechanic-checklist"><% trabajos.forEach(x=>{ %><div class="work-edit-row"><div class="mechanic-item quotation-item"><span class="mechanic-checkbox"><i class="fa fa-wrench"></i></span><strong><%= x.descripcion %></strong><small>Propuesto</small></div><div class="work-item-actions"><details class="admin-work-edit"><summary><i class="fa fa-pencil"></i> Editar</summary><form action="/ordenes/trabajos/<%= x.id %>/editar" method="POST" data-preserve-scroll><input name="descripcion" value="<%= x.descripcion %>" required><button class="btn btn-dark btn-sm">Guardar</button></form></details><form action="/ordenes/trabajos/<%= x.id %>/eliminar" method="POST" data-preserve-scroll onsubmit="return confirm('¿Quitar este elemento de la cotización?')"><button class="work-remove-button"><i class="fa fa-trash-o"></i> Quitar</button></form></div></div><% }) %></div>
<form action="/ordenes/<%= o.id %>/trabajos" method="POST" data-preserve-scroll><input type="hidden" name="tipo" value="detectado"><textarea name="descripcion" rows="6" class="mechanic-list-input" placeholder="Una línea por elemento...&#10;Pastillas de freno delanteras&#10;Rectificación de discos&#10;Filtro de aire" required></textarea><div class="section-actions"><button class="btn btn-danger btn-lg">+ Agregar a la cotización</button></div></form></section>

<section class="simple-sheet" id="repuestos"><div class="sheet-title"><div><span>COBRO COTIZADO</span><h3>Repuestos y materiales</h3></div><span><%= rep.length %> agregado(s)</span></div>
<p class="text-muted">Toque los elementos de la lista que desea cobrar. Luego ajuste descripción, cantidad y precio unitario.</p>
<div class="parts-from-work"><% trabajos.forEach(x=>{const usado=yaEnRepuestos(x.descripcion);%><form action="/ordenes/trabajos/<%= x.id %>/repuesto" method="POST" data-preserve-scroll><button class="part-pick <%= usado?'selected':'' %>" type="submit" <%= usado?'disabled':'' %>><span class="mechanic-checkbox <%= usado?'checked':'' %>"><%= usado?'✓':'+' %></span><span><strong><%= x.descripcion %></strong><small>Elemento cotizado</small></span><b><%= usado?'Agregado':'Agregar al cobro' %></b></button></form><% }) %></div>
<% if(rep.length){ %><div class="parts-edit-list"><div class="parts-edit-head"><span>Descripción</span><span>Cantidad</span><span>Precio unitario</span><span>Total</span><span></span></div><% rep.forEach(x=>{const t=Number(x.cantidad)*Number(x.precio);%><form action="/ordenes/repuestos/<%= x.id %>/editar" method="POST" class="parts-edit-row" data-preserve-scroll><input name="descripcion" value="<%= x.descripcion %>" required><input type="number" min="0.01" step="0.01" name="cantidad" value="<%= x.cantidad %>" required><input type="number" min="0" step="0.01" name="precio" value="<%= x.precio %>" required><strong><%= money(t) %></strong><button class="btn btn-dark btn-sm">Guardar</button></form><% }) %></div><% }else{ %><p class="empty-inline">Aún no hay elementos en el cobro.</p><% } %>
<details class="manual-work"><summary>Agregar un repuesto o material directamente al cobro</summary><form action="/ordenes/<%= o.id %>/repuestos" method="POST" data-preserve-scroll class="parts-row"><input name="descripcion" placeholder="Repuesto o material" required><input type="number" min="0.01" step=".01" name="cantidad" value="1" required><input type="number" min="0" step=".01" name="precio" placeholder="Precio cotizado" required><button class="btn btn-dark">+ Agregar</button></form></details>
<div class="cost-box"><div><span>Subtotal</span><strong><%= money(subtotal) %></strong></div><div><span>IVA 13%</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(subtotal+iva) %></strong></div></div></section>

<section class="simple-sheet" id="cuenta-taller"><div class="sheet-title"><div><span>SERVICIOS</span><h3>Cuenta cotizada</h3></div><form action="/ordenes/<%= o.id %>/limpiar-cobro" method="POST" onsubmit="return confirm('¿Limpiar los montos y repuestos de esta cotización?')"><button class="btn btn-outline-danger btn-sm">Limpiar cobro</button></form></div>
<form action="/ordenes/<%= o.id %>/totales" method="POST" data-preserve-scroll class="totals-grid"><div><label>Mano de obra / servicios</label><input type="number" step=".01" name="mano_obra" value="<%= o.manoObra||0 %>"></div><div><label>Otros</label><input type="number" step=".01" name="otros" value="<%= o.otros||0 %>"></div><div><label>Descuento</label><input type="number" step=".01" name="descuento" value="<%= o.descuento||0 %>"></div><button class="btn btn-dark">Guardar</button></form><div class="grand-total"><span>TOTAL COTIZADO</span><strong><%= money(total) %></strong></div></section>

<section class="simple-sheet client-advance quotation-client" id="adelanto-cliente"><div class="sheet-title"><div><span>PARA ENVIAR AL CLIENTE</span><h3>Detalle de cotización</h3></div></div>
<label class="client-note-label" for="client-note">Nota para el cliente</label><textarea id="client-note" class="mechanic-list-input client-note" rows="3" placeholder="Ejemplo: Cotización válida por 15 días."></textarea>
<div id="quotation-preview" class="advance-preview"><div class="advance-brand"><strong>CASTELI</strong><span>Cotización</span></div><div class="advance-vehicle"><strong><%= vehiculo.placa %> · <%= vehiculo.modelo %> <%= vehiculo.anio||'' %></strong><span><%= vehiculo.cliente?.nombre||'' %></span></div><% if(trabajos.length){ %><h4>Detalle propuesto</h4><ol class="advance-detail-list"><% trabajos.forEach(x=>{ %><li><%= x.descripcion %></li><% }) %></ol><% } %><% if(rep.length){ %><h4>Repuestos y materiales</h4><% rep.forEach(x=>{ %><div class="advance-line"><span><%= x.descripcion %> × <%= x.cantidad %></span><strong><%= money(Number(x.cantidad)*Number(x.precio)) %></strong></div><% }) %><div class="advance-line muted"><span>IVA (13 %)</span><strong><%= money(iva) %></strong></div><% } %><h4>Servicios de taller</h4><div class="advance-line"><span>Mano de obra / servicios</span><strong><%= money(mano) %></strong></div><% if(otros){ %><div class="advance-line"><span>Otros</span><strong><%= money(otros) %></strong></div><% } %><div class="advance-line muted"><span>IVA servicio de taller (13 %)</span><strong><%= money(ivaTaller) %></strong></div><% if(descuento){ %><div class="advance-line"><span>Descuento</span><strong>- <%= money(descuento) %></strong></div><% } %><div class="advance-total"><span>Total cotizado</span><strong><%= money(total) %></strong></div><p id="quotation-note-preview" class="advance-note-preview"></p></div>
<button type="button" id="download-quotation" class="btn btn-danger btn-lg"><i class="fa fa-download"></i> Descargar imagen de cotización</button></section>

<section class="simple-sheet quotation-continue"><div class="quotation-continue-copy"><span class="form-eyebrow">COTIZACIÓN APROBADA</span><h3>Continuar con esta cotización</h3><p>Convierte este borrador en la reparación actual. La lista y el cobro se conservan; los usuarios del taller podrán marcar cada trabajo conforme se vaya realizando.</p></div><form action="/ordenes/<%= o.id %>/continuar-cotizacion" method="POST" onsubmit="return confirm('¿El cliente aprobó esta cotización? Se convertirá en la reparación actual y conservará todos los trabajos, repuestos y precios.')"><button class="btn btn-success btn-lg">✓ Continuar con esta cotización</button></form></section>
<div class="simple-actions"><a href="/ordenes" class="btn btn-outline-secondary">Volver a reparaciones</a></div>
<% } %>
</div></div>

<script>
(()=>{const note=document.getElementById('client-note'),notePreview=document.getElementById('quotation-note-preview');if(note&&notePreview)note.addEventListener('input',()=>notePreview.textContent=note.value.trim());
const btn=document.getElementById('download-quotation');if(!btn)return;
const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{maximumFractionDigits:2});
const wrap=(ctx,text,max)=>{const words=String(text||'').split(/\s+/),lines=[];let line='';words.forEach(w=>{const t=line?line+' '+w:w;if(ctx.measureText(t).width>max&&line){lines.push(line);line=w}else line=t});if(line)lines.push(line);return lines};
const logo=()=>new Promise(resolve=>{const i=new Image();i.onload=()=>resolve(i);i.onerror=()=>resolve(null);i.src='/images/logo-casteli.png'});
btn.addEventListener('click',async()=>{const items=<%- JSON.stringify(trabajos.map(x=>x.descripcion)) %>,parts=<%- JSON.stringify(rep.map(x=>({descripcion:x.descripcion,cantidad:Number(x.cantidad),precio:Number(x.precio)}))) %>,W=1200,p=70,right=1130;const c=document.createElement('canvas'),ctx=c.getContext('2d');ctx.font='19px Arial';let itemH=items.reduce((s,x)=>s+Math.max(32,wrap(ctx,x,980).length*25+8),0);let partH=parts.reduce((s,x)=>s+Math.max(40,wrap(ctx,x.descripcion,600).length*23+12),0);c.width=W;c.height=Math.max(900,650+itemH+partH);ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);ctx.fillStyle='#202224';ctx.fillRect(0,0,W,145);const img=await logo();if(img){const sc=Math.min(245/img.width,82/img.height);ctx.drawImage(img,p,18,img.width*sc,img.height*sc)}else{ctx.fillStyle='#fff';ctx.font='bold 48px Arial';ctx.fillText('CASTELI',p,70)}ctx.fillStyle='#fff';ctx.textAlign='right';ctx.font='bold 22px Arial';ctx.fillText('COTIZACIÓN',right,62);ctx.font='16px Arial';ctx.fillText('<%= o.numeroOrden %> · '+new Date().toLocaleDateString('es-CR'),right,92);ctx.textAlign='left';let y=200;ctx.fillStyle='#111';ctx.font='bold 32px Arial';ctx.fillText('<%- String(vehiculo.placa).replace(/'/g,"\\'") %> · <%- String(vehiculo.modelo).replace(/'/g,"\\'") %>',p,y);ctx.font='20px Arial';ctx.fillStyle='#555';ctx.fillText('<%- String(vehiculo.cliente?.nombre||'').replace(/'/g,"\\'") %>',p,y+34);y+=88;const title=t=>{ctx.fillStyle='#111';ctx.font='bold 25px Arial';ctx.fillText(t,p,y);y+=34};title('Detalle propuesto');items.forEach((x,i)=>{ctx.font='18px Arial';const ls=wrap(ctx,x,980),h=Math.max(32,ls.length*25+8);ctx.fillStyle=i%2?'#fff':'#fafafa';ctx.fillRect(p,y,W-p*2,h);ctx.fillStyle='#333';ctx.font='bold 17px Arial';ctx.fillText((i+1)+'.',p+10,y+23);ctx.font='18px Arial';ls.forEach((l,j)=>ctx.fillText(l,p+48,y+23+j*25));y+=h});y+=24;title('Repuestos y materiales');const descX=p+10,qtyX=790,priceX=965,totalX=right-10;ctx.fillStyle='#e9eaec';ctx.fillRect(p,y,W-p*2,38);ctx.fillStyle='#333';ctx.font='bold 16px Arial';ctx.textAlign='left';ctx.fillText('Descripción',descX,y+25);ctx.textAlign='center';ctx.fillText('Cant.',qtyX,y+25);ctx.textAlign='right';ctx.fillText('Precio',priceX,y+25);ctx.fillText('Total',totalX,y+25);ctx.textAlign='left';y+=38;parts.forEach((x,i)=>{ctx.font='17px Arial';const ls=wrap(ctx,x.descripcion,570),h=Math.max(42,ls.length*23+12);ctx.fillStyle=i%2?'#fff':'#f7f7f7';ctx.fillRect(p,y,W-p*2,h);ctx.fillStyle='#333';ls.forEach((l,j)=>ctx.fillText(l,descX,y+26+j*23));ctx.textAlign='center';ctx.fillText(String(x.cantidad),qtyX,y+26);ctx.textAlign='right';ctx.fillText(money(x.precio),priceX,y+26);ctx.font='bold 17px Arial';ctx.fillText(money(x.cantidad*x.precio),totalX,y+26);ctx.textAlign='left';y+=h});const row=(label,val)=>{ctx.textAlign='right';ctx.font='17px Arial';ctx.fillStyle='#333';ctx.fillText(label,960,y+27);ctx.font='bold 17px Arial';ctx.fillText(money(val),right-10,y+27);ctx.textAlign='left';y+=38};row('Subtotal',<%= subtotal %>);row('IVA (13 %)',<%= iva %>);y+=20;title('Servicios de taller');row('Mano de obra / servicios',<%= mano %>);<% if(otros){ %>row('Otros',<%= otros %>);<% } %>row('IVA servicio de taller (13 %)',<%= ivaTaller %>);<% if(descuento){ %>row('Descuento',-<%= descuento %>);<% } %>y+=18;ctx.fillStyle='#202224';ctx.fillRect(p,y,W-p*2,70);ctx.fillStyle='#fff';ctx.font='bold 23px Arial';ctx.fillText('TOTAL COTIZADO',p+22,y+44);ctx.textAlign='right';ctx.font='bold 31px Arial';ctx.fillText(money(<%= total %>),right-18,y+46);ctx.textAlign='left';y+=105;const n=(note?.value||'').trim();if(n){ctx.fillStyle='#555';ctx.font='16px Arial';wrap(ctx,n,1040).forEach((l,j)=>ctx.fillText(l,p,y+j*22))}c.toBlob(async blob=>{if(!blob)return;const filename='Casteli_<%= vehiculo.placa %>_cotizacion.png',file=new File([blob],filename,{type:'image/png'});if(navigator.share&&navigator.canShare?.({files:[file]})){try{await navigator.share({files:[file],title:'Cotización Casteli'});return}catch(e){if(e.name==='AbortError')return}}const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000)},'image/png',1)})})();
</script>
