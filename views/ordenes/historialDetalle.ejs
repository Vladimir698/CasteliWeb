<%
const trabajos=orden.trabajos||[],realizados=trabajos.filter(x=>x.estado!=='detectado'),pendientes=trabajos.filter(x=>x.estado==='detectado'),rep=orden.repuestos||[];
const subtotal=rep.reduce((s,x)=>s+(Number(x.cantidad)||0)*(Number(x.precio)||0)-(Number(x.descuento)||0),0),iva=subtotal*.13,totalRep=subtotal+iva,mano=Number(orden.manoObra||0),otros=Number(orden.otros||0),descuento=Number(orden.descuento||0),total=Math.max(0,totalRep+mano+otros-descuento);
const money=n=>'₡'+Number(n||0).toLocaleString('es-CR',{minimumFractionDigits:2,maximumFractionDigits:2});
%>
<div class="content"><div class="container-fluid casteli-simple-page">
<div class="history-detail-nav"><a href="/vehiculos/<%= orden.vehiculo.id %>#historial" class="btn btn-outline-secondary"><i class="fa fa-arrow-left"></i> Volver a la ficha</a></div>
<section class="vehicle-sheet-hero history-visit-hero"><div><span>HISTORIAL DE VISITA</span><h1><%= orden.vehiculo.placa %></h1><p><%= orden.vehiculo.modelo %> <%= orden.vehiculo.anio||'' %> · <%= orden.numeroOrden %></p></div><div><small>Estado</small><strong><%= orden.estado?.nombre||'' %></strong><span><%= new Date(orden.fechaRecepcion).toLocaleDateString('es-CR') %></span></div></section>
<section class="simple-sheet"><div class="sheet-title"><div><span>DATOS DE LA VISITA</span><h3><%= orden.numeroOrden %></h3></div><span><%= orden.responsableTrabajo ? 'Responsable: '+orden.responsableTrabajo : '' %></span></div><div class="history-info-grid"><div><span>Propietario</span><strong><%= orden.vehiculo.cliente?.nombre||'Sin propietario' %></strong></div><div><span>Fecha de ingreso</span><strong><%= new Date(orden.fechaRecepcion).toLocaleDateString('es-CR') %></strong></div><div><span>Kilometraje de ingreso</span><strong><%= Number(orden.kilometrajeIngreso||0).toLocaleString('es-CR') %> km</strong></div><div><span>Finalizada</span><strong><%= orden.fechaFin ? new Date(orden.fechaFin).toLocaleDateString('es-CR') : '—' %></strong></div><div class="wide"><span>Motivo de ingreso</span><strong><%= orden.problemaReportado||'—' %></strong></div><% if(orden.observaciones){ %><div class="wide"><span>Observaciones</span><strong><%= orden.observaciones %></strong></div><% } %></div></section>
<section class="simple-sheet"><div class="sheet-title"><div><span>REPARACIÓN</span><h3>Trabajos realizados</h3></div><span><%= realizados.length %> trabajo(s)</span></div><% if(realizados.length){ %><div class="history-work-list"><% realizados.forEach(x=>{ %><div class="history-work-item"><span class="history-check">✓</span><div><strong><%= x.descripcion %></strong><% if(x.fechaFin){ %><small>Completado <%= new Date(x.fechaFin).toLocaleDateString('es-CR') %></small><% } %></div></div><% }) %></div><% }else{ %><p class="empty-inline">No se registraron trabajos realizados en esta visita.</p><% } %><% if(pendientes.length){ %><details class="history-pending"><summary>Ver <%= pendientes.length %> trabajo(s) que quedaron pendientes</summary><ul><% pendientes.forEach(x=>{ %><li><%= x.descripcion %></li><% }) %></ul></details><% } %></section>
<% if(esAdmin){ %><section class="simple-sheet"><div class="sheet-title"><div><span>REPUESTOS Y MATERIALES</span><h3>Detalle utilizado / cobrado</h3></div><span><%= rep.length %> elemento(s)</span></div><% if(rep.length){ %><div class="table-responsive"><table class="table history-parts-table"><thead><tr><th>Descripción</th><th>Cantidad</th><th>Precio unitario</th><th>Total</th></tr></thead><tbody><% rep.forEach(x=>{ %><tr><td><strong><%= x.descripcion %></strong></td><td><%= Number(x.cantidad).toLocaleString('es-CR') %></td><td><%= money(x.precio) %></td><td><strong><%= money(Number(x.cantidad)*Number(x.precio)-Number(x.descuento||0)) %></strong></td></tr><% }) %></tbody></table></div><% }else{ %><p class="empty-inline">No se registraron repuestos o materiales.</p><% } %></section>
<section class="simple-sheet history-payment-sheet"><div class="sheet-title"><div><span>COBRO DE LA VISITA</span><h3>Resumen de pagos y servicios</h3></div></div><div class="history-money-list"><div><span>Subtotal repuestos</span><strong><%= money(subtotal) %></strong></div><div><span>IVA repuestos (13%)</span><strong><%= money(iva) %></strong></div><div><span>Repuestos + IVA</span><strong><%= money(totalRep) %></strong></div><div><span>Mano de obra / servicios</span><strong><%= money(mano) %></strong></div><% if(otros){ %><div><span>Otros</span><strong><%= money(otros) %></strong></div><% } %><% if(descuento){ %><div><span>Descuento</span><strong>- <%= money(descuento) %></strong></div><% } %><div class="history-money-total"><span>TOTAL DE LA VISITA</span><strong><%= money(total) %></strong></div></div><div class="history-close-meta"><div><span>Trabajo realizado por</span><strong><%= orden.responsableTrabajo||'No indicado' %></strong></div><div><span>Registro cerrado por</span><strong><%= orden.finalizadoPor||'No indicado' %></strong></div><% if(orden.gtiEstado){ %><div><span>Facturación electrónica</span><strong><%= orden.gtiEstado %><%= orden.gtiReferencia?' · '+orden.gtiReferencia:'' %></strong></div><% } %></div></section><% } %>
<div class="simple-actions"><a href="/vehiculos/<%= orden.vehiculo.id %>" class="btn btn-dark"><i class="fa fa-car"></i> Ficha del vehículo</a><a href="/ordenes/nueva/<%= orden.vehiculo.id %>" class="btn btn-danger"><i class="fa fa-plus"></i> Nueva reparación</a></div>
</div></div>