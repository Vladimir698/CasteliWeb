<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>TALLER</span><h2>Lista de reparaciones</h2></div><a href="/vehiculos/buscar" class="btn btn-danger">+ Recibir vehículo</a></div><% if(!ordenes?.length){ %><div class="text-center py-5"><h4>No hay vehículos en reparación</h4><p class="text-muted">Cuando ingrese un vehículo aparecerá aquí.</p></div><% } else { %><div class="repair-list"><% ordenes.forEach(o=>{ %><a href="/vehiculos/<%= o.vehiculo?.id %>" class="home-action-card mb-2"><i class="fa fa-car"></i><div><h3><%= o.vehiculo?.placa||'Sin placa' %> · <%= o.vehiculo?.modelo||'' %></h3><p><%= o.vehiculo?.cliente?.nombre||'Sin cliente' %> · <%= o.problemaReportado %></p></div><div class="text-right"><strong><%= o.estado?.nombre||'' %></strong><br><small><%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></small></div></a><% }) %></div><% } %></section></div></div>
