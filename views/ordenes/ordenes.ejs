<div class="content">
  <div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2>Órdenes de trabajo</h2>
        <p class="text-muted">
          Consulte las órdenes activas del taller.
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">

        <% if (!ordenes || ordenes.length === 0) { %>

          <div class="text-center py-5">
            <i
              class="fa fa-wrench"
              style="font-size: 40px; color: #d71920;"
            ></i>

            <h4 class="mt-3">
              No hay órdenes activas
            </h4>

            <p class="text-muted">
              Las nuevas órdenes aparecerán aquí.
            </p>
          </div>

        <% } else { %>

          <div class="table-responsive">
            <table class="table table-hover">

              <thead>
                <tr>
                  <th>N.º orden</th>
                  <th>Vehículo</th>
                  <th>Cliente</th>
                  <th>Estado</th>
                  <th>Fecha</th>
                  <th>Prioridad</th>
                  <th></th>
                </tr>
              </thead>

              <tbody>

                <% ordenes.forEach(orden => { %>

                  <tr>
                    <td>
                      <strong>
                        <%= orden.numeroOrden %>
                      </strong>
                    </td>

                    <td>
                      <% if (orden.vehiculo) { %>
                        <%= orden.vehiculo.placa %><br>
                        <small class="text-muted">
                          <%= orden.vehiculo.marca %>
                          <%= orden.vehiculo.modelo %>
                        </small>
                      <% } else { %>
                        Sin vehículo
                      <% } %>
                    </td>

                    <td>
                      <%= orden.vehiculo?.cliente?.nombre || 'Sin cliente' %>
                    </td>

                    <td>
                      <span class="badge badge-danger">
                        <%= orden.estado?.nombre || 'Sin estado' %>
                      </span>
                    </td>

                    <td>
                      <%= orden.fechaRecepcion
                        ? new Date(orden.fechaRecepcion).toLocaleDateString('es-CR')
                        : '-'
                      %>
                    </td>

                    <td>
                      <%= orden.prioridad || 'Normal' %>
                    </td>

                    <td class="text-right">
                      <a
                        href="/ordenes/<%= orden.id %>"
                        class="btn btn-sm btn-outline-danger"
                      >
                        Ver
                      </a>
                    </td>
                  </tr>

                <% }) %>

              </tbody>
            </table>
          </div>

        <% } %>

      </div>
    </div>

  </div>
</div>