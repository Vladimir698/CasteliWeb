<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>TALLER</span><h2>Reparaciones activas</h2><p class="text-muted mb-0">Vehículos que se encuentran actualmente en proceso.</p></div><a href="/vehiculos/buscar" class="btn btn-danger"><i class="fa fa-plus mr-1"></i> Recibir vehículo</a></div><% if(!ordenes?.length){ %><div class="text-center py-5"><span class="action-icon mx-auto mb-3"><i class="fa fa-check"></i></span><h4>No hay vehículos en reparación</h4><p class="text-muted">Cuando ingrese un vehículo aparecerá aquí.</p></div><% } else { %><div class="repair-list"><% ordenes.forEach(o=>{ %><a href="/vehiculos/<%= o.vehiculo?.id %>" class="home-action-card mb-2"><span class="action-icon"><i class="fa fa-car"></i></span><div><h3><%= o.vehiculo?.placa||'Sin placa' %> · <%= o.vehiculo?.modelo||'' %></h3><p><%= o.vehiculo?.cliente?.nombre||'Sin propietario' %><%= o.problemaReportado ? ' · '+o.problemaReportado : '' %></p></div><div class="repair-card-status"><strong><%= o.estado?.nombre||'' %></strong><small><i class="fa fa-calendar-o"></i> <%= new Date(o.fechaRecepcion).toLocaleDateString('es-CR') %></small></div><i class="fa fa-chevron-right action-arrow"></i></a><% }) %></div><% } %></section></div></div>