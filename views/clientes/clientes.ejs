<div class="container-fluid py-4">
  <div class="d-flex justify-content-between mb-4">
    <div>
      <h1 class="h3">Clientes</h1>
      <p class="text-muted">
        Clientes y vehículos registrados en el taller.
      </p>
    </div>

    <a href="/clientes/nuevo" class="btn btn-primary">
      Nuevo cliente
    </a>
  </div>

  <form method="GET" action="/clientes" class="mb-4">
    <div class="input-group">
      <input
        type="search"
        name="buscar"
        value="<%= busqueda %>"
        class="form-control"
        placeholder="Buscar por nombre, identificación o teléfono"
      >

      <button class="btn btn-outline-primary">
        Buscar
      </button>
    </div>
  </form>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Vehículos</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% clientes.forEach(cliente => { %>
            <tr>
              <td>
                <strong><%= cliente.nombre %></strong><br>
                <small class="text-muted">
                  <%= cliente.identificacion || 'Sin identificación' %>
                </small>
              </td>

              <td><%= cliente.telefono || '-' %></td>

              <td>
                <%= cliente.vehiculos?.length || 0 %>
              </td>

              <td class="text-end">
                <a
                  href="/clientes/<%= cliente.id %>"
                  class="btn btn-sm btn-outline-primary"
                >
                  Ver
                </a>
              </td>
            </tr>
          <% }) %>

          <% if (!clientes.length) { %>
            <tr>
              <td colspan="4" class="text-center py-4 text-muted">
                No se encontraron clientes.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>