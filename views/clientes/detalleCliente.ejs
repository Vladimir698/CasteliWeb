<div class="content"><div class="container-fluid casteli-simple-page"><section class="simple-sheet"><div class="sheet-title"><div><span>CLIENTE</span><h2><%= cliente.nombre %></h2><p class="text-muted mb-0"><%= cliente.identificacion||'' %> · <%= cliente.telefono||'Sin teléfono' %></p></div><a href="/vehiculos/nuevo?clienteId=<%= cliente.id %>" class="btn btn-danger">+ Agregar vehículo</a></div><% if(!cliente.vehiculos?.length){ %><p class="text-muted">Este cliente todavía no tiene vehículos.</p><% } %><div class="home-action-grid"><% cliente.vehiculos?.forEach(v=>{ %><a href="/vehiculos/<%= v.id %>" class="home-action-card"><i class="fa fa-car"></i><div><h3><%= v.placa %></h3><p><%= v.modelo %> <%= v.anio||'' %> · <%= Number(v.kilometrajeActual||0).toLocaleString('es-CR') %> km</p></div><span>→</span></a><% }) %></div></section></div></div>
