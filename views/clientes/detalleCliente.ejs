<div class="container-fluid py-4">
  <div class="d-flex justify-content-between mb-4">
    <div>
      <h1 class="h3"><%= cliente.nombre %></h1>
      <p class="text-muted mb-0">
        <%= cliente.telefono || 'Sin teléfono registrado' %>
      </p>
    </div>

    <a
      href="/vehiculos/nuevo/<%= cliente.id %>"
      class="btn btn-primary"
    >
      Agregar vehículo
    </a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <h2 class="h5 mb-3">Vehículos</h2>

      <% if (!cliente.vehiculos?.length) { %>
        <p class="text-muted">
          Este cliente todavía no tiene vehículos registrados.
        </p>
      <% } %>

      <div class="row">
        <% cliente.vehiculos?.forEach(vehiculo => { %>
          <div class="col-md-6 col-xl-4 mb-3">
            <div class="border rounded p-3 h-100">
              <h3 class="h5"><%= vehiculo.placa %></h3>

              <p class="mb-1">
                <%= vehiculo.marca %>
                <%= vehiculo.modelo %>
                <%= vehiculo.anio || '' %>
              </p>

              <p class="text-muted">
                Kilometraje:
                <%= vehiculo.kilometraje_actual?.toLocaleString('es-CR') || '-' %>
                km
              </p>

              <a
                href="/vehiculos/<%= vehiculo.id %>"
                class="btn btn-sm btn-outline-primary"
              >
                Ver historial
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>