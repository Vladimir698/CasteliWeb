<div class="content">
  <div class="container-fluid">

    <section class="responsive-form-card">

      <header class="responsive-form-header">
        <div>
          <span class="form-eyebrow">NUEVO REGISTRO</span>
          <h2>Registrar cliente</h2>
          <p>
            Ingrese los datos del propietario o responsable del vehículo.
          </p>
        </div>

        <div class="d-none d-md-flex align-items-center">
          <i
            class="fa fa-user-plus"
            aria-hidden="true"
            style="font-size: 38px; color: #d71920;"
          ></i>
        </div>
      </header>

      <% if (errores && errores.length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <strong>No fue posible guardar el cliente:</strong>

          <ul class="mb-0 mt-2">
            <% errores.forEach(error => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form
        action="/clientes"
        method="POST"
        autocomplete="off"
      >
        <div class="responsive-form-grid">

          <div class="form-group">
            <label for="tipo_cliente">
              Tipo de cliente
            </label>

            <select
              id="tipo_cliente"
              name="tipo_cliente"
              class="form-control"
            >
              <option
                value="persona"
                <%= cliente?.tipo_cliente === 'persona' ||
                    cliente?.tipoCliente === 'persona'
                    ? 'selected'
                    : ''
                %>
              >
                Persona
              </option>

              <option
                value="empresa"
                <%= cliente?.tipo_cliente === 'empresa' ||
                    cliente?.tipoCliente === 'empresa'
                    ? 'selected'
                    : ''
                %>
              >
                Empresa
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="identificacion">
              Identificación
            </label>

            <input
              id="identificacion"
              name="identificacion"
              type="text"
              class="form-control"
              maxlength="30"
              value="<%= cliente?.identificacion || '' %>"
              placeholder="Cédula física, jurídica o DIMEX"
            >
          </div>

          <div class="form-group form-group-full">
            <label for="nombre">
              Nombre completo o razón social
              <span class="text-danger">*</span>
            </label>

            <input
              id="nombre"
              name="nombre"
              type="text"
              class="form-control"
              maxlength="150"
              value="<%= cliente?.nombre || '' %>"
              placeholder="Ejemplo: Juan Pérez Rodríguez"
              required
              autofocus
            >
          </div>

          <div class="form-group">
            <label for="telefono">
              Teléfono
            </label>

            <input
              id="telefono"
              name="telefono"
              type="tel"
              class="form-control"
              maxlength="30"
              inputmode="tel"
              value="<%= cliente?.telefono || '' %>"
              placeholder="8888-8888"
            >
          </div>

          <div class="form-group">
            <label for="correo">
              Correo electrónico
            </label>

            <input
              id="correo"
              name="correo"
              type="email"
              class="form-control"
              maxlength="150"
              inputmode="email"
              value="<%= cliente?.correo || '' %>"
              placeholder="cliente@correo.com"
            >
          </div>

          <div class="form-group form-group-full">
            <label for="direccion">
              Dirección
            </label>

            <textarea
              id="direccion"
              name="direccion"
              class="form-control"
              rows="3"
              placeholder="Provincia, cantón, distrito y otras señas"
            ><%= cliente?.direccion || '' %></textarea>
          </div>

          <div class="form-group form-group-full">
            <label for="notas">
              Notas adicionales
            </label>

            <textarea
              id="notas"
              name="notas"
              class="form-control"
              rows="3"
              placeholder="Información relevante sobre el cliente"
            ><%= cliente?.notas || '' %></textarea>
          </div>

        </div>

        <div class="responsive-form-actions">
          <a
            href="/clientes"
            class="btn btn-outline-secondary"
          >
            <i class="fa fa-times" aria-hidden="true"></i>
            Cancelar
          </a>

          <button
            type="submit"
            class="btn btn-danger"
          >
            <i class="fa fa-save" aria-hidden="true"></i>
            Guardar cliente
          </button>
        </div>
      </form>

    </section>

  </div>
</div>