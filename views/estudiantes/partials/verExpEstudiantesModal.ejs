<%
  const formData = (typeof estudiante !== 'undefined' && estudiante) ? estudiante : {};
  const provinciasArr = (typeof provincias !== 'undefined' && provincias) ? provincias : [];
%>

<form autocomplete="off">
  <!-- Datos personales -->
  <div class="row">
    <div class="col-md-4 pr-1">
      <div class="form-group">
        <label>Cédula</label>
        <input type="text" class="form-control" value="<%= formData.cedula || '' %>" disabled />
      </div>
    </div>

    <div class="col-md-4 px-1">
      <div class="form-group">
        <label>Nombre</label>
        <input type="text" class="form-control" value="<%= formData.nombre || '' %>" disabled />
      </div>
    </div>

    <div class="col-md-4 pl-1">
      <div class="form-group">
        <label>Apellidos</label>
        <input type="text" class="form-control" value="<%= formData.apellidos || '' %>" disabled />
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 pr-1">
      <div class="form-group">
        <label>Nacionalidad</label>
        <input type="text" class="form-control" value="<%= formData.nacionalidad || '' %>" disabled />
      </div>
    </div>

    <div class="col-md-4 px-1">
      <div class="form-group">
        <label>Fecha de nacimiento</label>
        <input type="date" class="form-control" value="<%= formData.fechaNacimiento || '' %>" disabled />
      </div>
    </div>

    <div class="col-md-4 pl-1">
      <div class="form-group">
        <label>Diagnóstico</label>
        <input type="text" class="form-control" value="<%= formData.diagnostico || '' %>" disabled />
      </div>
    </div>
  </div>

  <!-- Dirección -->
  <div class="row">
    <div class="col-md-4 pr-1">
      <div class="form-group">
        <label>Provincia</label>
        <select id="provincia_modal" class="form-control" disabled>
          <option value="">Seleccione...</option>
          <% provinciasArr.forEach(p => { %>
            <option value="<%= p %>" <%= (formData.provincia === p) ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="col-md-4 px-1">
      <div class="form-group">
        <label>Cantón</label>
        <select id="canton_modal" class="form-control" disabled>
          <option value="">Seleccione...</option>
        </select>
      </div>
    </div>

    <div class="col-md-4 pl-1">
      <div class="form-group">
        <label>Distrito</label>
        <select id="distrito_modal" class="form-control" disabled>
          <option value="">Seleccione...</option>
        </select>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="form-group">
        <label>Dirección exacta</label>
        <input type="text" class="form-control" value="<%= formData.direccionExacta || '' %>" disabled />
      </div>
    </div>
  </div>

  <!-- Opciones -->
  <div class="row">
    <div class="col-12">
      <div class="form-group">
        <label class="d-block">Opciones</label>

        <div class="d-flex align-items-center" style="gap: 18px;">
          <div class="form-check mb-0">
            <label class="form-check-label">
              <input class="form-check-input" type="checkbox" disabled <%= (formData.beca === 'on' || formData.beca === true) ? 'checked' : '' %> />
              Beca
              <span class="form-check-sign"></span>
            </label>
          </div>

          <div class="form-check mb-0">
            <label class="form-check-label">
              <input class="form-check-input" type="checkbox" disabled <%= (formData.estado === 'on' || formData.estado === true) ? 'checked' : '' %> />
              Activo
              <span class="form-check-sign"></span>
            </label>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Valores para que el JS rehidrate cantón/distrito -->
  <input type="hidden" id="provinciaInicial_modal" value="<%= formData.provincia || '' %>">
  <input type="hidden" id="cantonInicial_modal" value="<%= formData.canton || '' %>">
  <input type="hidden" id="distritoInicial_modal" value="<%= formData.distrito || '' %>">
</form>